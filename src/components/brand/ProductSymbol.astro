---
import { COLORS, JELLY, PRODUCTS } from "../../data/brand.mjs";

interface Props {
	product: keyof typeof PRODUCTS;
	size?: number;
	animated?: boolean;
	wake?: boolean;
}

const { product, size = 32, animated = true, wake = false } = Astro.props;
const { color, eyes, period } = PRODUCTS[product];
const showOpen = wake || eyes === "open";
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="8 6 86 88"
	width={size}
	height={size}
	class:list={{ "is-waking": wake }}
	style={{ "--mascot-blue-dark": COLORS.blueDark }}
	role="img"
	aria-label={product === "homun" ? "Homun" : "Engramma"}
	data-mascot
	data-mascot-animated={animated ? "" : undefined}
	data-product={product}
>
	<g data-mascot-body>
		<path d={JELLY[0]} fill={COLORS[color]} data-mascot-shape>
			{animated && (
				<animate data-mascot-morph attributeName="d" begin="indefinite"
					dur={`${period}s`} repeatCount="indefinite" values={[...JELLY, JELLY[0]].join(";")} />
			)}
		</path>
		<g data-mascot-eyes data-max="5">
			<path data-eyes-closed d="M33 50Q39.5 58 46 50M54 50Q60.5 58 67 50" fill="none"
				stroke={COLORS.cream} stroke-width="5" stroke-linecap="round"
				visibility={showOpen ? "hidden" : "visible"} />
			<g data-eyes-open fill={COLORS.cream} visibility={showOpen ? "visible" : "hidden"}>
				<rect x="35" y="38" width="9" height="20" rx="4.5" />
				<rect x="56" y="38" width="9" height="20" rx="4.5" />
			</g>
		</g>
	</g>
</svg>
