---
import CommandBlock from "./CommandBlock.astro";
import { ENGRAMMA_CLIENTS, ENGRAMMA_RELEASE } from "../../data/engramma.mjs";
---

<section id="connect" class="connect" aria-labelledby="connect-title">
	<div class="inner">
		<header>
			<p class="eyebrow">Connect</p>
			<h2 id="connect-title">Your memory in the assistant you use.</h2>
			<p class="lead">
				Engramma speaks MCP. Local apps start it on your computer; web and mobile apps reach it over HTTPS with OAuth.
				Only the memory spaces you name are exposed, and an assistant can read them or propose new notes, nothing more.
			</p>
		</header>

		<div class="tabs" data-tabs>
			<div class="tablist" role="tablist" aria-label="MCP clients">
				{ENGRAMMA_CLIENTS.map(({ id, name, tested }, index) => (
					<button type="button" role="tab" id={`tab-${id}`} aria-controls={`panel-${id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>
						{name}{tested && <span class="tested">tested</span>}
					</button>
				))}
			</div>
			{ENGRAMMA_CLIENTS.map(({ id, name, kind, label, lang, code, note }) => (
				<div class="panel" role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} data-panel>
					<p class="kind">{name} · {kind === "local" ? "local, over stdio" : "remote, over HTTPS + OAuth 2.1"}</p>
					<CommandBlock label={label} code={code} lang={lang} />
					{note && <p class="note">{note}</p>}
				</div>
			))}
		</div>

		<p class="more">
			Add <code>--write default --actor &lt;name&gt;</code> to let an assistant propose notes: they wait in a queue until you
			accept them with <code>engramma review</code>. Clients without the “tested” mark use their standard MCP
			configuration and have not been exercised with this release yet. Details: <a href={ENGRAMMA_RELEASE.mcpDocsUrl}>local clients</a>,
			<a href={ENGRAMMA_RELEASE.httpDocsUrl}>remote clients and tunnels</a>.
		</p>
	</div>
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
		const select = (index: number, focus = false) => {
			tabs.forEach((tab, i) => {
				tab.setAttribute("aria-selected", String(i === index));
				tab.tabIndex = i === index ? 0 : -1;
				panels[i].hidden = i !== index;
			});
			if (focus) tabs[index].focus();
		};
		tabs.forEach((tab, i) => {
			tab.addEventListener("click", () => select(i));
			tab.addEventListener("keydown", (event) => {
				const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
				if (step) select((i + step + tabs.length) % tabs.length, true);
			});
		});
		select(0);
	}
</script>

<style>
	.connect { padding-block: clamp(90px, 14vh, 160px); }
	.inner { display: grid; gap: clamp(28px, 5vw, 48px); max-width: 1180px; margin-inline: auto; padding-inline: 16px; }
	header { display: grid; gap: 18px; max-width: 46rem; }
	.eyebrow { font: .76rem/1.55 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--teal-text); }
	h2 { font-size: clamp(2.1rem, 5.6vw, 4.2rem); }
	.lead { font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.55; color: var(--muted); }
	.tabs { display: grid; gap: 18px; max-width: 860px; min-width: 0; }
	.tablist { display: flex; flex-wrap: wrap; gap: 8px; }
	[role="tab"] { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); border-radius: 999px; padding: .45em 1em; background: transparent; color: var(--muted); font: 500 .9rem/1.2 var(--body); cursor: pointer; }
	[role="tab"][aria-selected="true"] { background: var(--fg); border-color: var(--fg); color: var(--bg); }
	.tested { font: .6rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--teal-text); }
	[aria-selected="true"] .tested { color: inherit; opacity: .8; }
	.panel { display: grid; gap: 12px; min-width: 0; }
	.kind { font: .78rem/1.5 var(--mono); color: var(--muted); }
	.note { font-size: .9rem; color: var(--muted); max-width: 60ch; }
	.more { max-width: 46rem; color: var(--muted); line-height: 1.6; }
	.more a { color: var(--teal-text); text-decoration: underline; }
	code { font-family: var(--mono); font-size: .9em; }
</style>
