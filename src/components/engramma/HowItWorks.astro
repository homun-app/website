---
import { ENGRAMMA_HOW, ENGRAMMA_DIFFERENT } from "../../data/engramma.mjs";
---

<section id="how" class="block" aria-labelledby="how-title">
	<div class="inner">
		<header>
			<p class="eyebrow">How it works</p>
			<h2 id="how-title">A log, readable notes, a search that explains.</h2>
		</header>
		<ol class="how">
			{ENGRAMMA_HOW.map(({ title, body }) => (
				<li><h3>{title}</h3><p>{body}</p></li>
			))}
		</ol>
	</div>
</section>

<section id="different" class="block band" aria-labelledby="different-title">
	<div class="inner">
		<header>
			<p class="eyebrow">Why Engramma</p>
			<h2 id="different-title">Memory you can check.</h2>
			<p class="lead">Most memory layers for assistants are a store the assistant writes into and you have to trust. Engramma is built the other way round.</p>
		</header>
		<div class="table" role="table" aria-label="Engramma compared with the usual assistant memory">
			<div class="row head" role="row">
				<span role="columnheader"></span>
				<span role="columnheader">Usual assistant memory</span>
				<span role="columnheader">Engramma</span>
			</div>
			{ENGRAMMA_DIFFERENT.map(({ topic, usual, engramma }) => (
				<div class="row" role="row">
					<b role="rowheader">{topic}</b>
					<span role="cell" class="usual">{usual}</span>
					<span role="cell" class="ours">{engramma}</span>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.block { padding-block: clamp(90px, 14vh, 160px); }
	.band { background: var(--band); color: var(--band-fg); }
	.inner { display: grid; gap: clamp(28px, 5vw, 48px); max-width: 1180px; margin-inline: auto; padding-inline: 16px; }
	header { display: grid; gap: 18px; max-width: 46rem; }
	.eyebrow { font: .76rem/1.55 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--teal-text); }
	.band .eyebrow { color: #8EA3F2; }
	h2 { font-size: clamp(2.1rem, 5.6vw, 4.2rem); }
	.lead { font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.55; color: var(--band-muted); }
	.how { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; padding: 0; margin: 0; list-style: none; counter-reset: how; }
	.how li { display: grid; align-content: start; gap: 10px; min-width: 0; padding: 22px; border: 1px solid var(--line); border-radius: 22px; background: var(--surface); counter-increment: how; }
	.how h3 { font-size: 1.1rem; }
	.how h3::before { content: counter(how) "  "; font-family: var(--mono); color: var(--teal-text); }
	.how p { color: var(--muted); line-height: 1.55; font-size: .95rem; }
	.table { display: grid; border-radius: 22px; overflow: hidden; background: var(--band-card); }
	.row { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr) minmax(0, 1.2fr); gap: 16px; padding: 16px 22px; border-top: 1px solid rgb(255 255 255 / .08); }
	.row.head { border-top: 0; font: .74rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--band-muted); }
	.usual { color: var(--band-muted); }
	.ours { color: var(--band-fg); }
	@media (max-width: 980px) { .how { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 640px) {
		.how { grid-template-columns: minmax(0, 1fr); }
		.row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
		.row.head { display: none; }
		.usual::before { content: "Usual: "; font-family: var(--mono); font-size: .78em; }
		.ours::before { content: "Engramma: "; font-family: var(--mono); font-size: .78em; color: #8EA3F2; }
	}
</style>
