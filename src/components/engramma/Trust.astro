---
import { ENGRAMMA_TRUST } from "../../data/engramma.mjs";
---

<section id="trust" class="trust" aria-labelledby="trust-title">
	<div class="inner">
		<header>
			<p class="eyebrow">Trust</p>
			<h2 id="trust-title">Yours to run, yours to check.</h2>
		</header>
		<ul class="grid">
			{ENGRAMMA_TRUST.map(({ title, body }) => (
				<li><h3>{title}</h3><p>{body}</p></li>
			))}
		</ul>
	</div>
</section>

<style>
	.trust { padding-block: clamp(90px, 14vh, 160px); }
	.inner { display: grid; gap: clamp(28px, 5vw, 48px); max-width: 1180px; margin-inline: auto; padding-inline: 16px; }
	header { display: grid; gap: 18px; }
	.eyebrow { font: .76rem/1.55 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--teal-text); }
	h2 { font-size: clamp(2.1rem, 5.6vw, 4.2rem); }
	.grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; padding: 0; margin: 0; list-style: none; }
	li { display: grid; align-content: start; gap: 10px; min-width: 0; padding-top: 18px; border-top: 1px solid var(--line); }
	h3 { font-size: 1.1rem; }
	p { color: var(--muted); line-height: 1.55; font-size: .95rem; }
	@media (max-width: 980px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 560px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
