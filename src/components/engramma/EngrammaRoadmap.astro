---
import { ENGRAMMA_ROADMAP, ENGRAMMA_RELEASE } from "../../data/engramma.mjs";
---

<section id="roadmap" class="roadmap" aria-labelledby="roadmap-title">
	<div class="inner">
		<header>
			<p class="eyebrow">Roadmap</p>
			<h2 id="roadmap-title">From one person to a whole team.</h2>
			<p class="lead">Engramma grows from your own memory to a team’s, and then to a company’s, without giving up local files and checks you can run.</p>
		</header>
		<div class="stages">
			{ENGRAMMA_ROADMAP.map(({ stage, items }) => (
				<section class="stage" aria-label={stage}>
					<h3>{stage}</h3>
					<ul>
						{items.map(({ version, title, body }) => (
							<li><span class="version">{version}</span><b>{title}</b><span>{body}</span></li>
						))}
					</ul>
				</section>
			))}
		</div>
		<p class="source">The detailed plan lives in the <a href={ENGRAMMA_RELEASE.designUrl}>design document</a>.</p>
	</div>
</section>

<style>
	.roadmap { padding-block: clamp(90px, 14vh, 160px); background: var(--band); color: var(--band-fg); }
	.inner { display: grid; gap: clamp(28px, 5vw, 48px); max-width: 1180px; margin-inline: auto; padding-inline: 16px; }
	.eyebrow { font: .76rem/1.55 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: #8EA3F2; }
	h2 { font-size: clamp(2.1rem, 5.6vw, 4.2rem); margin-top: 18px; }
	.stages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
	.stage { display: grid; align-content: start; gap: 14px; min-width: 0; padding: 22px; border-radius: 22px; background: var(--band-card); }
	h3 { font: .8rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--band-muted); }
	ul { display: grid; gap: 16px; padding: 0; margin: 0; list-style: none; }
	li { display: grid; gap: 4px; }
	li span { color: var(--band-muted); font-size: .95rem; line-height: 1.5; }
	li .version { justify-self: start; font: .7rem/1.4 var(--mono); letter-spacing: .04em; color: #8EA3F2; }
	.lead { font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.55; color: var(--band-muted); max-width: 46rem; margin-top: 18px; }
	.source { color: var(--band-muted); }
	.source a { color: inherit; text-decoration: underline; }
	@media (max-width: 920px) { .stages { grid-template-columns: minmax(0, 1fr); } }
</style>
