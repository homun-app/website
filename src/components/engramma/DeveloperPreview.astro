---
import CommandBlock from "./CommandBlock.astro";
import {
	ENGRAMMA_RELEASE,
	ENGRAMMA_INSTALL_COMMAND,
	ENGRAMMA_CLAUDE_CODE_COMMAND,
	ENGRAMMA_CLAUDE_CONFIG,
} from "../../data/engramma.mjs";
---

<section id="developers" class="preview" aria-labelledby="developers-title">
	<div class="inner">
		<header>
			<p class="eyebrow">Developer preview · {ENGRAMMA_RELEASE.version}</p>
			<h2 id="developers-title">Give your memory to Claude.</h2>
			<p class="lead">
				Engramma is an open-source Rust engine. The preview ships the <code>engramma</code> command line and an MCP
				server: Claude and other MCP clients can search the memory spaces you choose, and propose new notes that wait
				for your review.
			</p>
		</header>

		<ol class="steps">
			<li>
				<h3>Install</h3>
				<CommandBlock label="Terminal" code={ENGRAMMA_INSTALL_COMMAND} />
				<ul class="platforms" aria-label="Platforms">
					{ENGRAMMA_RELEASE.platforms.map(({ label, shipped }) => (
						<li class:list={["chip", { later: !shipped }]}>{label}{!shipped && <span class="tag"> not yet</span>}</li>
					))}
				</ul>
				<p class="note">The macOS binary is not signed yet. The terminal installer is not blocked by Gatekeeper; a file downloaded from the browser is.</p>
			</li>
			<li>
				<h3>Start a memory</h3>
				<CommandBlock label="Terminal" code={`engramma init\necho "Acme only signs annual contracts." > note.md\nengramma add note.md --source user --confidence stated --title "Acme contracts"\nengramma search "annual contracts"`} />
			</li>
			<li>
				<h3>Connect Claude</h3>
				<CommandBlock label="Claude Code" code={ENGRAMMA_CLAUDE_CODE_COMMAND} />
				<details>
					<summary>Claude Desktop</summary>
					<CommandBlock label="claude_desktop_config.json" code={ENGRAMMA_CLAUDE_CONFIG} lang="json" />
				</details>
			</li>
		</ol>

		<p class="beta">
			A beta: the command line can still change. Memory files written by this version will open in every later one
			— <a href={ENGRAMMA_RELEASE.compatibilityUrl}>the compatibility promise</a>.
		</p>
		<nav class="links" aria-label="Engramma on GitHub">
			<a class="btn btn-primary" href={ENGRAMMA_RELEASE.releaseUrl}>Release {ENGRAMMA_RELEASE.version}</a>
			<a class="btn btn-ghost" href={ENGRAMMA_RELEASE.readmeUrl}>Read the guide</a>
			<a class="btn btn-ghost" href={ENGRAMMA_RELEASE.repository}>Source on GitHub</a>
		</nav>
	</div>
</section>

<style>
	.preview { padding-block: clamp(90px, 14vh, 160px); }
	.inner { display: grid; gap: clamp(28px, 5vw, 48px); max-width: 1180px; margin-inline: auto; padding-inline: 16px; }
	header { display: grid; gap: 18px; max-width: 46rem; }
	.eyebrow { font: .76rem/1.55 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--teal-text); }
	h2 { font-size: clamp(2.1rem, 5.6vw, 4.2rem); }
	.lead { font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.55; color: var(--muted); }
	.steps { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; max-width: 860px; padding: 0; margin: 0; list-style: none; counter-reset: step; }
	.steps > li { display: grid; align-content: start; gap: 12px; min-width: 0; counter-increment: step; }
	h3 { font-size: 1.15rem; }
	h3::before { content: counter(step) " · "; font-family: var(--mono); color: var(--teal-text); }
	.platforms { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; list-style: none; font-size: .82rem; color: var(--muted); }
	.chip { border: 1px solid var(--line); border-radius: 999px; padding: .2em .75em; }
	.later { opacity: .6; }
	.tag { font: .66rem var(--mono); letter-spacing: .06em; text-transform: uppercase; }
	.note { font-size: .86rem; color: var(--muted); }
	details { display: grid; gap: 10px; }
	summary { cursor: pointer; font-size: .9rem; color: var(--muted); }
	.beta { max-width: 46rem; color: var(--muted); }
	.beta a { color: var(--teal-text); text-decoration: underline; }
	.links { display: flex; flex-wrap: wrap; gap: 12px; }
	code { font-family: var(--mono); font-size: .92em; }
</style>
