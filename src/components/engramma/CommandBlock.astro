---
// A command or config snippet with a copy button. The text is rendered
// verbatim; the button copies exactly what is shown.
interface Props {
	label: string;
	code: string;
	lang?: "sh" | "json";
}
const { label, code, lang = "sh" } = Astro.props;
---

<figure class="command" data-command>
	<figcaption>
		<span>{label}</span>
		<button type="button" data-copy aria-label={`Copy: ${label}`}>Copy</button>
	</figcaption>
	<pre data-lang={lang}><code>{code}</code></pre>
</figure>

<script>
	for (const block of document.querySelectorAll<HTMLElement>("[data-command]")) {
		const button = block.querySelector<HTMLButtonElement>("[data-copy]");
		const code = block.querySelector("code")?.textContent ?? "";
		button?.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(code);
				button.textContent = "Copied";
			} catch {
				button.textContent = "Select and copy";
			}
			setTimeout(() => (button.textContent = "Copy"), 1800);
		});
	}
</script>

<style>
	.command { display: grid; min-width: 0; margin: 0; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); overflow: hidden; }
	figcaption { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 10px 8px 16px; border-bottom: 1px solid var(--line); font: .74rem/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
	button { border: 1px solid var(--line); border-radius: 999px; padding: .25em .9em; background: transparent; color: inherit; font: inherit; cursor: pointer; }
	button:hover { color: var(--fg); border-color: var(--fg); }
	pre { margin: 0; padding: 14px 16px; overflow-x: auto; font: .84rem/1.6 var(--mono); color: var(--fg); text-align: left; }
	code { white-space: pre; }
</style>
