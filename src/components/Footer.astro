---
import ProductSymbol from "./brand/ProductSymbol.astro";
import StarButton from "./ui/StarButton.astro";
import { RELEASES_PAGE_URL } from "../scripts/downloads.mjs";
import { fetchStarCount } from "../lib/github-stars.mjs";

const stars = await fetchStarCount();
---

<footer>
	<div class="links">
		<a href="/license/">Open source · Apache-2.0</a>
		<a href="/changelog/">Changelog</a>
		<a href="/roadmap/">Roadmap</a>
		<a href="/privacy/">Privacy</a>
		<a href={RELEASES_PAGE_URL} data-analytics-download-source="footer">All releases</a>
		<StarButton count={stars} />
		<div class="family">
			<a href="/"><ProductSymbol product="homun" size={18} animated={false} /> Homun</a>
			<a href="/engramma/"><ProductSymbol product="engramma" size={18} animated={false} /> Engramma</a>
		</div>
	</div>
</footer>

<style>
	footer { border-top: 1px solid var(--line); padding-block: 28px; color: var(--muted); font-size: .84rem; }
	.links { width: min(100% - 32px, 1148px); margin-inline: auto; display: flex; align-items: center; flex-wrap: wrap; gap: 12px 18px; }
	a:hover { text-decoration: underline; }
	.family { display: flex; flex-wrap: wrap; gap: 14px; margin-inline-start: auto; }
	.family a { display: inline-flex; align-items: center; gap: 6px; }
	@media (max-width: 640px) { .family { margin-inline-start: 0; } }
</style>
