---
import ProductSymbol from "./brand/ProductSymbol.astro";
import { RELEASES_PAGE_URL, downloadLabel } from "../scripts/downloads.mjs";
import { buildTimeOffer } from "../lib/download-offer.mjs";

const isHome = Astro.url.pathname === "/";
// The mark follows the product of the page: the blue jelly and "Install
// Engramma" on Engramma's page and its docs, Homun everywhere else. Each mark
// leads to its own product's home.
const path = Astro.url.pathname;
const isEngramma = path === "/engramma" || path.startsWith("/engramma/") || path === "/docs/engramma" || path.startsWith("/docs/engramma/");
// The full label says what the build-time offer ships; the resolver rewrites
// it for the visitor's system once it runs.
const offer = buildTimeOffer();
const offeredPlatform = ["macos", "windows", "linux"].find((platform) => offer.available[platform]);
const navDownloadLabel = offeredPlatform ? downloadLabel(offeredPlatform, offer) : "Download";
---

<header id="site-nav" class:list={["inset-x-0 top-0 z-50", isHome ? "home-nav sticky" : "fixed"]} data-nav-product={isEngramma ? "engramma" : "homun"}>
	<nav aria-label="Primary navigation">
		<a href={isEngramma ? "/engramma/" : "/"} class="nav-mark" data-product={isEngramma ? "engramma" : "homun"} aria-label={isEngramma ? "Engramma home" : "Homun home"}>
			<ProductSymbol product={isEngramma ? "engramma" : "homun"} size={26} />
			<span class="word">{isEngramma ? "engramma" : "homun"}</span>
		</a>
		<ul>
			<li><a href="/">Homun</a></li>
			<li><a href="/engramma/">Engramma <span class="soon">Preview</span></a></li>
			<li><a href="/docs/">Docs</a></li>
		</ul>
		{isEngramma ? (
			<a href="/engramma/#install" class="download" data-engramma-install>Install Engramma</a>
		) : (
			<a href={RELEASES_PAGE_URL} data-homun-download data-analytics-download-source="navigation" class="download">
				<span class="compact" data-download-label="compact">Download</span>
				<span class="full" data-download-label="full">{navDownloadLabel}</span>
			</a>
		)}
	</nav>
</header>

<style>
	header {
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
		backdrop-filter: saturate(1.6) blur(14px);
	}
	nav { width: min(100% - 32px, 1148px); margin-inline: auto; height: 55px; display: flex; align-items: center; gap: 22px; }
	.nav-mark { flex: none; display: flex; align-items: center; gap: 8px; font: 800 1.2rem var(--display); letter-spacing: -.03em; text-decoration: none; }
	.nav-mark :global(svg) { display: block; }
	ul { display: flex; align-items: center; gap: 20px; margin-inline-start: auto; list-style: none; color: var(--muted); font-size: .92rem; }
	ul a:hover { text-decoration: underline; }
	.soon { background: var(--surface); border-radius: 6px; padding: .18em .5em; font: .64rem var(--mono); text-transform: uppercase; }
	.download { flex: none; border-radius: 999px; padding: .5em 1em; background: var(--fg); color: var(--bg); font-size: .88rem; font-weight: 600; }
	.compact { display: none; }
	@media (max-width: 640px) {
		ul, .full { display: none; }
		.compact { display: inline; }
		.download { margin-inline-start: auto; }
	}
</style>
