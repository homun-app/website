---
import BotAvatar from "./BotAvatar.astro";
import type { ComponentProps } from "astro/types";

interface Props {
  title?: string;
  bot?: Pick<ComponentProps<typeof BotAvatar>, "family" | "color" | "state"> & { name: string };
  status?: string;
  i?: number;
  class?: string;
}

const { title, bot, status, i, class: className } = Astro.props;
---

<div class:list={["surface", className, { play: i !== undefined }]} style={{ "--i": i }} data-surface>
  {(title || bot || status) && (
    <div class="bar">
      {bot && <BotAvatar family={bot.family} color={bot.color} state={bot.state} size={26} />}
      {(title || bot) && <b>{title ?? bot?.name}</b>}
      {status && <span>{title || bot ? "· " : ""}{status}</span>}
    </div>
  )}
  <slot />
</div>

<style>
  .surface {
    display: grid;
    gap: 10px;
    width: 100%;
    min-width: 0;
    padding: clamp(16px, 3vw, 28px);
    border-radius: 22px;
    background: var(--a-bg);
    color: var(--a-fg);
    font: 14px/1.45 var(--body);
    text-align: left;
    overflow-wrap: anywhere;
    box-shadow: 0 30px 80px -34px rgb(10 20 18 / .45), 0 0 0 1px var(--a-line);
  }

  .bar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; font-size: 12.5px; color: var(--a-mfg); }
  .bar b { color: var(--a-fg); font-weight: 600; }
</style>
