---
interface Props {
  time?: string;
  i?: number;
}

const { time, i } = Astro.props;
---

<div class:list={["done", { play: i !== undefined }]} style={{ "--i": i }} data-done>
  <span class="check" aria-hidden="true">✓</span>
  <span><slot /></span>
  {time && <time>{time}</time>}
</div>

<style>
  .done { display: flex; gap: 8px; align-items: center; color: var(--a-mfg); font-size: 13px; padding-left: 4px; }
  .check { color: var(--ok); font-weight: 700; }
  time { margin-left: auto; font-size: 12px; }
</style>
