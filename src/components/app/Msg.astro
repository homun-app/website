---
import BotAvatar from "./BotAvatar.astro";
import type { ComponentProps } from "astro/types";

interface Props {
  from: "me" | "bot" | "member";
  who?: string;
  botFamily?: ComponentProps<typeof BotAvatar>["family"];
  botColor?: string;
  i?: number;
}

const { from, who, botFamily, botColor, i } = Astro.props;
---

<div class:list={["msg", { me: from === "me", who, play: i !== undefined }]} style={{ "--i": i }} data-from={from}>
  {who && (
    <span class="name">
      {botFamily && botColor && <BotAvatar family={botFamily} color={botColor} size={18} mini />}
      {who}
    </span>
  )}
  <div><slot /></div>
</div>

<style>
  .msg {
    width: fit-content;
    max-width: 78%;
    padding: 9px 14px;
    border-radius: 18px;
    background: var(--a-bubble);
    align-self: flex-start;
    justify-self: start;
    overflow-wrap: anywhere;
  }

  .me { align-self: flex-end; justify-self: end; background: var(--a-user); color: var(--a-bg); }
  .who { display: grid; gap: 3px; }
  .name { display: flex; gap: 6px; align-items: center; font-size: 11.5px; color: var(--a-mfg); font-weight: 600; }
  .me .name { color: inherit; }
</style>
