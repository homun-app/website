---
interface Props {
  kind: "draft" | "approval" | "routine" | "skill";
  i?: number;
  class?: string;
}

const { kind, i, class: className } = Astro.props;
---

<div class:list={["card", className, { play: i !== undefined }]} style={{ "--i": i }} data-card={kind}>
  {Astro.slots.has("title") && <div class="heading"><slot name="title" /></div>}
  {Astro.slots.has("sub") && <div class="sub"><slot name="sub" /></div>}
  {(Astro.slots.has("body") || Astro.slots.has("default")) && <div class="body"><slot name="body"><slot /></slot></div>}
  {Astro.slots.has("buttons") && <div class="buttons"><slot name="buttons" /></div>}
</div>

<style>
  .card { background: var(--a-muted); border-radius: 16px; padding: 12px 14px; display: grid; gap: 8px; min-width: 0; overflow-wrap: anywhere; }
  .heading { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13.5px; font-weight: 600; }
  .heading :global(small) { color: var(--a-mfg); font-size: 12px; font-weight: 400; }
  .sub { font-size: 12px; color: var(--a-mfg); }
  .body { background: var(--a-card); border-radius: 10px; padding: 9px 12px; font-size: 13px; }
  .buttons { display: flex; gap: 8px; flex-wrap: wrap; }
</style>
