---
// The steps of a method, with the point of light that travels through them.
// The stages light up in order, around the clock: it is one of the three
// animations of the family that loop (with the hub and the roadmap's "Now").
interface Stage {
	/** The short name above the title: "Write", "Log…". */
	name: string;
	title: string;
	body: string;
	items?: readonly string[];
	/** The stage the method is built around: drawn in the product's accent. */
	core?: boolean;
	/** The Engramma stage: drawn in Engramma's blue, on any product's page. */
	mem?: boolean;
}

interface Props {
	product: "homun" | "engramma";
	stages: readonly Stage[];
	label: string;
	class?: string;
}

const { product, stages, label, class: className } = Astro.props;
const count = stages.length;
// One stage every 1.4 s. The light leaves the left edge and exits the right one.
const cycle = `${count * 1.4}s`;
const packet = `packet-${count}`;
const stops = stages.map((_, index) => {
	const at = (index / count) * 100;
	return `${at}%{left:${at}%}`;
}).join(";");
const travel = `@keyframes ${packet}{0%{opacity:0;left:0}4%{opacity:1}${stops}96%{opacity:1;left:100%}100%{opacity:0;left:100%}}`;
---

<style is:inline set:html={travel} />

<div class:list={["pipe", className]} data-product={product} data-motion="rise" role="list" aria-label={label}
	style={`--n:${count};--cycle:${cycle};--packet:${packet}`}>
	<span class="track" aria-hidden="true"><i /></span>
	{stages.map(({ name, title, body, items, core, mem }, index) => (
		<div class:list={["stage", { core, mem }]} role="listitem" style={`--i:${index}`}>
			<p class="n">{index + 1} · {name}</p>
			<h3>{title}</h3>
			<p>{body}</p>
			{items && <ul>{items.map((item) => <li>{item}</li>)}</ul>}
		</div>
	))}
</div>

<style>
	.pipe { position: relative; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 14px; }
	.stage { position: relative; display: grid; align-content: start; gap: 10px; min-width: 0; padding: 18px; border: 1px solid var(--line); border-radius: 20px; background: var(--card); }
	.stage .n { margin: 0; font: .7rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent-text); }
	.stage h3 { font-size: 1.15rem; }
	.stage > p:not(.n) { margin: 0; font-size: .88rem; color: var(--muted); }
	.stage ul { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; font: .74rem/1.45 var(--mono); }
	.stage li { padding: 5px 8px; border-radius: 8px; background: var(--surface); }
	.stage:not(:last-child)::after { content: "→" / ""; position: absolute; top: 22px; right: -12px; z-index: 1; color: var(--accent-text); font-weight: 700; }
	.stage.core { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); background: var(--accent-soft); }
	.stage.mem { border-color: color-mix(in srgb, var(--blue) 30%, var(--line)); background: var(--blue-soft); }
	.stage.mem .n { color: var(--blue-text); }

	/* The point of light rides on a track above the stages. The track starts
	   7 px (half the light) before the pipeline and ends 7 px after its last
	   stage begins… so at 0 % and 100 % the centre of the light sits exactly
	   on the pipeline's edges. */
	.track { position: absolute; top: -12px; right: 7px; left: -7px; height: 14px; pointer-events: none; }
	.track i { position: absolute; top: 0; left: 0; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent); opacity: 0; }

	@media (prefers-reduced-motion: no-preference) {
		.pipe.in .track i { animation: var(--packet) var(--cycle) cubic-bezier(.6, 0, .4, 1) infinite; }
		.pipe.in .stage { animation: f-lit var(--cycle) infinite; animation-delay: calc(var(--i) * var(--cycle) / var(--n)); }
	}

	@keyframes f-lit {
		0%, 14% { box-shadow: 0 0 0 2px var(--accent), 0 18px 40px -20px var(--accent); transform: translateY(-4px); }
		22%, 100% { box-shadow: none; transform: none; }
	}

	@media (max-width: 980px) {
		.pipe { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.stage::after { display: none; }
	}
	@media (max-width: 640px) {
		.pipe { grid-template-columns: minmax(0, 1fr); }
	}
</style>
