---
// What shipped, what is being done, what comes next, and where it all goes.
// The data decides the columns: one for each group of shipped releases, then
// "Now", then "Next", then "Later" when the page has one. The component lives
// on the dark band of its section.
import type { Era } from "./types";

interface Props {
	product: "homun" | "engramma";
	shipped: readonly Era[];
	now: Era;
	next: Era;
	later?: Era;
	vision?: readonly { title: string; body: string }[];
	/** The progress of "Now", when it is measured: milestones done and total. */
	progress?: { done: number; total: number };
	class?: string;
}

const { product, shipped, now, next, later, vision, progress, class: className } = Astro.props;
const eras = [
	...shipped.map((era) => ({ era, state: "shipped" })),
	{ era: now, state: "now" },
	{ era: next, state: "next" },
	...(later ? [{ era: later, state: "later" }] : []),
];
---

<div class:list={["roadmap", className]}>
	<div class="road" data-product={product} data-motion="rise" style={`--columns:${eras.length}`}>
		{progress && (
			<p class="progress" role="progressbar" aria-label={`Progress of ${now.label}`} aria-valuemin={0} aria-valuemax={progress.total} aria-valuenow={progress.done}>
				<span><i style={`width:${progress.total ? (progress.done / progress.total) * 100 : 0}%`} /></span>
				{progress.done} of {progress.total} milestones
			</p>
		)}
		{eras.map(({ era, state }) => (
			<section class:list={["era", state]} data-era={state} aria-label={era.label}>
				<h3>{era.label}</h3>
				{era.releases.map(({ version, meta, title, body, href }) => (
					<div class="rel">
						<span class="v">{version}{meta && ` · ${meta}`}</span>
						{href ? <b><a href={href}>{title}</a></b> : <b>{title}</b>}
						<span>{body}</span>
					</div>
				))}
			</section>
		))}
	</div>
	{vision && (
		<ul class="vision" role="list">
			{vision.map(({ title, body }) => (
				<li><b>{title}</b><span>{body}</span></li>
			))}
		</ul>
	)}
</div>

<style>
	.roadmap { display: grid; gap: 36px; }
	.road { position: relative; display: grid; grid-template-columns: repeat(var(--columns), minmax(0, 1fr)); gap: 18px; }
	.era { display: grid; align-content: start; gap: 14px; padding: 20px; border-radius: 22px; background: var(--band-card); }
	.era h3 { margin: 0; font: 500 .74rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--band-muted); }
	.era.now { outline: 2px solid var(--accent); }
	.rel { display: grid; gap: 3px; padding-left: 16px; border-left: 2px solid #2a3532; }
	.rel .v { font: .72rem/1.4 var(--mono); color: var(--accent-text); }
	.rel b { font-size: .98rem; line-height: 1.3; }
	.rel a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: .18em; }
	.rel a:hover { text-decoration-color: currentColor; }
	.rel span:not(.v) { font-size: .86rem; line-height: 1.45; color: var(--band-muted); }
	/* What has not shipped yet is sketched, not drawn. */
	.era.next .rel,
	.era.later .rel { border-left-style: dashed; }

	/* The bar runs above every column, on a row of its own. */
	.progress { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 10px; margin: 0 0 -4px; font: .7rem/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--band-muted); }
	.progress span { grid-column: 1 / -1; display: block; height: 3px; border-radius: 2px; background: #2a3532; }
	.progress i { display: block; height: 100%; border-radius: 2px; background: linear-gradient(90deg, var(--accent), var(--accent-text)); }

	.vision { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 0; padding: 0; list-style: none; }
	.vision li { padding-top: 16px; border-top: 1px solid #2a3532; }
	.vision b { display: block; margin-bottom: 6px; font: 800 1.4rem var(--display); letter-spacing: -.03em; }
	.vision span { font-size: .92rem; color: var(--band-muted); }

	@media (prefers-reduced-motion: no-preference) {
		:global(html.js) .road:not(.in) {
			opacity: 0;
			transform: translateY(18px);
		}
		.road { transition: opacity .7s, transform .7s; }
		.road.in .progress i { animation: f-fill 1.2s cubic-bezier(.2, .7, .2, 1) .3s both; }
		/* "Now" breathes: it is the only part of the roadmap that loops. */
		.era.now { animation: f-now 3s ease-in-out infinite; }
	}

	@keyframes f-fill {
		from { width: 0; }
	}

	@keyframes f-now {
		50% { outline-color: var(--accent-text); box-shadow: 0 0 40px -10px var(--accent); }
	}

	@media (max-width: 980px) {
		.road, .vision { grid-template-columns: minmax(0, 1fr); }
	}
</style>
