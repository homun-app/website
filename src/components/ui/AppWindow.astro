---
interface Props {
	title: string;
	botName?: string;
	botEmoji?: string;
	computer?: boolean;
}

// Fake Homun app window: top bar, chat column (default slot) and, when
// `computer`, the bot's Computer panel on the right (`computer` slot). Below
// the md breakpoint (768 px) the Computer panel stacks under the chat.
const { title, botName, botEmoji, computer = false } = Astro.props;
---

<div data-app-window class="operator-panel sheen text-left">
	<div class="flex items-center gap-3 border-b border-line bg-surface-2/60 px-4 py-2.5">
		<div class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
			<span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
		</div>
		<p class="min-w-0 flex-1 truncate font-mono text-[11px] uppercase tracking-[0.12em] text-faint">{title}</p>
		{botName && (
			<p class="flex min-w-0 shrink-0 items-center gap-1.5 text-xs font-medium text-muted">
				{botEmoji && <span aria-hidden="true">{botEmoji}</span>}
				<span class="truncate">{botName}</span>
			</p>
		)}
	</div>

	<div class="grid md:grid-cols-[minmax(0,1fr)_16rem]">
		<div data-chat class="flex min-h-56 flex-col gap-3 p-4 sm:p-5">
			<slot />
		</div>
		{computer && (
			<aside data-computer-panel class="border-t border-line bg-surface-2/50 md:border-t-0 md:border-l">
				<p class="border-b border-line px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">Computer</p>
				<div class="p-4">
					<slot name="computer">
						<p class="flex items-center gap-2 font-mono text-[11px] leading-relaxed text-muted">
							<span class="status-dot"></span> sandbox · docker
						</p>
					</slot>
				</div>
			</aside>
		)}
	</div>
</div>
