---
interface Props {
	tool: string;
	detail: string;
	state?: "pending" | "allowed" | "denied";
}

// Fake approval card shown inside a scene chat: the bot hit a write and waits
// for a decision. The buttons are decorative (scenes are static), so they are
// aria-hidden and not focusable; `state` marks which action was taken.
const { tool, detail, state = "pending" } = Astro.props;

const stateLabel = state === "allowed" ? "allowed" : state === "denied" ? "denied" : null;
---

<div data-approval-card data-state={state} class="w-full rounded-2xl border border-line-strong bg-surface p-4">
	<div class="flex items-center justify-between gap-3">
		<p class="min-w-0 truncate font-mono text-[11px] uppercase tracking-[0.12em] text-accent-bright">{tool}</p>
		{stateLabel && (
			<p class="shrink-0 font-mono text-[10px] uppercase tracking-[0.12em] text-faint">{stateLabel}</p>
		)}
	</div>
	<p class="mt-2 text-sm leading-relaxed text-cream">{detail}</p>
	<div class="mt-4 flex flex-wrap gap-2">
		<button
			type="button"
			tabindex="-1"
			aria-hidden="true"
			class:list={[
				"rounded-lg border px-3 py-1.5 text-xs font-semibold",
				state === "allowed" ? "border-accent text-accent-bright" : "border-line text-muted",
			]}
		>
			Allow once
		</button>
		<button type="button" tabindex="-1" aria-hidden="true" class="rounded-lg border border-line px-3 py-1.5 text-xs font-semibold text-muted">
			Always allow
		</button>
		<button
			type="button"
			tabindex="-1"
			aria-hidden="true"
			class:list={[
				"rounded-lg border px-3 py-1.5 text-xs font-semibold",
				state === "denied" ? "border-accent text-accent-bright" : "border-line text-muted",
			]}
		>
			Deny
		</button>
	</div>
</div>
