---
interface Props {
	from: "user" | "bot" | "system";
	status?: "done" | "draft" | "held";
}

// One row of a scene chat. `user` bubbles sit on the right with a neutral
// fill, `bot` replies on the left, `system` rows are small centered lines
// (e.g. "⏱ routine «backup»"). `status` labels what happened to the action.
const { from, status } = Astro.props;

const statusMeta = {
	done: { symbol: "✓", label: "done" },
	draft: { symbol: "✎", label: "draft" },
	held: { symbol: "⏸", label: "held" },
}[status];
---

<div
	data-from={from}
	data-status={status}
	class:list={[
		"flex w-full",
		from === "user" ? "justify-end" : from === "bot" ? "justify-start" : "justify-center",
	]}
>
	{from === "system" ? (
		<p class="px-4 text-center font-mono text-[11px] tracking-wide text-faint">
			<slot />
		</p>
	) : (
		<div
			class:list={[
				"max-w-[85%] rounded-2xl border border-line px-3.5 py-2.5 text-sm leading-relaxed",
				from === "user" ? "rounded-br-md bg-surface-2 text-cream" : "rounded-bl-md bg-surface text-cream",
			]}
		>
			<p><slot /></p>
			{statusMeta && (
				<p
					class:list={[
						"mt-1.5 flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.12em]",
						status === "done" ? "text-accent-bright" : "text-faint",
					]}
				>
					<span aria-hidden="true">{statusMeta.symbol}</span>
					{statusMeta.label}
				</p>
			)}
		</div>
	)}
</div>
