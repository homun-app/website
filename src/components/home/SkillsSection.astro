---
import DeepDive from "../family/DeepDive.astro";
import Card from "../app/Card.astro";
import Msg from "../app/Msg.astro";
import Pill from "../app/Pill.astro";
---

<DeepDive id="skills" product="homun" eyebrow="Skills" title="Teach it once. It keeps the recipe."
  lead="When a bot works out how you like something done, it offers to save it as a skill, and asks first. Or add skills from the catalog, as plugins in the Claude Code format, or import them from Cursor, Codex or Claude Code on your Mac."
  chips={["catalog", "Claude Code plugins", "import from other apps"]}>
  <div slot="visual" class="skill" data-motion="skill">
    <Msg from="bot">You fixed my expense report the same way three Fridays in a row. Want me to remember how?</Msg>
    <Card kind="skill">
      <Fragment slot="title">Inbox manager wants to change skills</Fragment>
      <Fragment slot="sub">Weekly expense report. When to use: on Fridays, or when you ask for expenses. Match receipts in Gmail to card payments, flag anything over €200, one table per project.</Fragment>
      <div class="swap">
        <div class="act before"><Pill primary class="pressed">Allow</Pill><Pill>Deny</Pill></div>
        <p class="tag after">✓ Weekly expense report · added to Skills</p>
      </div>
    </Card>
  </div>
</DeepDive>

<style>
  .skill { display: grid; gap: 10px; }
  .tag { margin: 0; align-self: center; padding: .15em .5em; border-radius: 6px; background: var(--accent-soft); font: .66rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); }
  .swap { display: grid; justify-items: start; }
  .swap > * { grid-area: 1 / 1; }
  .act { display: flex; gap: 8px; flex-wrap: wrap; }
  @media (prefers-reduced-motion: no-preference) {
    .skill.in .before { animation: f-out .2s ease 2.2s forwards; }
    .after { opacity: 0; }
    .skill.in .after { animation: f-line .3s ease 2.3s forwards; }
    .skill.in .pressed { animation: f-press-skill .5s ease 1.8s; }
  }
  @keyframes f-press-skill { 50% { background: var(--accent); color: #fff; } }
</style>
