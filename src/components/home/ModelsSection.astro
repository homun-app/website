---
import DeepDive from "../family/DeepDive.astro";
import BotAvatar from "../app/BotAvatar.astro";

const bots = [
  { name: "Daily briefing", family: "device", color: "#E7B93A", model: "Built-in (on your Mac)" },
  { name: "Account manager", family: "jelly", color: "#E9418A", model: "Ollama · on this Mac" },
  { name: "Scout", family: "robo", color: "#3F7BEA", model: "Anthropic · your key" },
] as const;

const providers = ["Anthropic", "OpenAI", "Mistral", "OpenRouter", "DeepSeek", "Groq", "xAI", "Z.ai", "any OpenAI-compatible"];
---

<DeepDive id="models" product="homun" tone="band" eyebrow="Any model" title="Your choice of model. Even fully local."
  lead="Use Anthropic, OpenAI, Mistral, DeepSeek or anything on OpenRouter. Or run models on your own computer — the one built into Homun, Ollama or LM Studio — and your conversations never leave it. Web searches, pages and apps a bot uses still go out. Pick a different model for each bot."
  chips={["a model per bot", "your own keys", "OpenAI-compatible"]}>
  <div slot="visual" class="models" data-motion="models">
    <div class="rows" role="list">
      {bots.map(({ name, family, color, model }, i) => (
        <div class="mrow" role="listitem">
          <span class="who"><BotAvatar {family} {color} size={28} />{name}<small>{model}</small></span>
          <span class:list={["local", { cloud: i === 2 }]}>{i === 2 ? "cloud" : "local"}</span>
        </div>
      ))}
    </div>
    <p class="provs">{providers.map((name) => <span>{name}</span>)}</p>
  </div>
</DeepDive>

<style>
  .models { display: grid; gap: 12px; }
  .rows { display: grid; gap: 10px; }
  .mrow { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 10px 12px; border: 1px solid var(--band-line, #2a3532); border-radius: 12px; background: #1E2725; font-size: .86rem; color: var(--band-fg); }
  .who { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .who small { color: var(--band-muted); font: .72rem var(--mono); }
  .local { color: var(--accent-band); font: .66rem var(--mono); letter-spacing: .06em; text-transform: uppercase; border: 1px solid #2f5a53; border-radius: 6px; padding: .1em .45em; }
  .local.cloud { color: var(--band-muted); border-color: var(--band-line, #2a3532); }
  .provs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .provs span { font: .72rem var(--mono); border: 1px solid var(--band-line, #2a3532); border-radius: 999px; padding: .15em .7em; color: var(--band-muted); }
  @media (prefers-reduced-motion: no-preference) {
    .local { opacity: .3; }
    .models.in .local:not(.cloud) { animation: f-on .4s ease forwards; }
    .models.in .mrow:nth-child(2) .local:not(.cloud) { animation-delay: .4s; }
    .models.in .mrow:nth-child(3) .local:not(.cloud) { animation-delay: .8s; }
  }
  @keyframes f-on { to { opacity: 1; box-shadow: 0 0 18px -4px #5CC2B3; } }
</style>
