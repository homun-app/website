---
import AppWindow from "../ui/AppWindow.astro";
import ChatMessage from "../ui/ChatMessage.astro";
import SceneSection from "../ui/SceneSection.astro";
---

<!-- "Engramma: memory" scene, the section that separates Homun from the
     pack. One bot learns a fact; the memory line marks it shared; a second
     bot picks it up later — and can say exactly where it came from. Engramma
     keeps everything on the user's computer: readable, erasable, searchable
     across the chat history. -->
<SceneSection
	id="memory"
	variant="highlight"
	eyebrow="Engramma"
	title="One bot learns. The team remembers."
	body="A fact told once becomes memory the whole team can use. Engramma keeps it on your computer: you can read every line, erase any of it, and search it — chat history included. A memory only reaches the model you chose for that bot, and only when the work needs it."
>
	<div class="flex flex-col gap-4">
		<AppWindow title="homun · inbox manager" botName="Inbox manager" botEmoji="📬">
			<ChatMessage from="user">acme only signs annual contracts — keep that in mind</ChatMessage>
			<ChatMessage from="bot" status="done">kept — acme only signs annual</ChatMessage>
			<ChatMessage from="system">Memory updated · shared with Account Manager</ChatMessage>
		</AppWindow>
		<AppWindow title="homun · account manager" botName="Account manager" botEmoji="🗂️">
			<ChatMessage from="bot">the acme offer runs 24 months — memory says they only sign annual</ChatMessage>
			<ChatMessage from="user">good catch. where did that come from?</ChatMessage>
			<ChatMessage from="bot" status="done">your own words from tuesday — found in engramma, and in the chat history</ChatMessage>
		</AppWindow>
	</div>
</SceneSection>
