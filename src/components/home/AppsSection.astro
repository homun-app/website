---
import DeepDive from "../family/DeepDive.astro";
import AppTile from "../app/AppTile.astro";

const apps = [
  { name: "Gmail", logo: "M", color: "#C73327", status: "work · personal", ok: true },
  { name: "Google Calendar", logo: "31", color: "#1967D2", status: "Connected", ok: true },
  { name: "Slack", logo: "#", color: "#4A154B", status: "Connected", ok: true },
  { name: "Notion", logo: "N", color: "#191919", status: "Direct MCP", ok: true },
  { name: "GitHub", logo: "gh", color: "#24292F", status: "via Composio" },
  { name: "HubSpot", logo: "H", color: "#B74627", status: "Connected", ok: true },
  { name: "Linear", logo: "L", color: "#5E6AD2", status: "Direct MCP" },
  { name: "Add MCP server", logo: "+", color: "#706C65", status: "your own tools" },
];
---

<DeepDive id="apps" product="homun" flip eyebrow="Apps" title="Connect your apps once. Every bot can use them."
  lead="Gmail, Calendar, Slack, Notion, GitHub and more than a thousand others through Composio, or any MCP server you add. Two Gmail accounts? Name them both, and the bot knows which one you mean. What a bot sends to an app is what it puts in the request."
  chips={["Composio · more than a thousand apps", "MCP servers", "Direct MCP"]}>
  <div slot="visual" class="apps" data-motion="">
    {apps.map((app, i) => <AppTile {...app} {i} />)}
  </div>
</DeepDive>

<style>
  .apps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .apps :global([data-app-tile] b) { white-space: normal; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .apps:not(.in) > * { opacity: 0; transform: scale(.9); }
    .apps.in > * { animation: f-pop .4s ease forwards; }
    .apps.in > :nth-child(2) { animation-delay: .12s; }
    .apps.in > :nth-child(3) { animation-delay: .24s; }
    .apps.in > :nth-child(4) { animation-delay: .36s; }
    .apps.in > :nth-child(5) { animation-delay: .48s; }
    .apps.in > :nth-child(6) { animation-delay: .6s; }
    .apps.in > :nth-child(7) { animation-delay: .72s; }
    .apps.in > :nth-child(8) { animation-delay: .84s; }
  }
  @keyframes f-pop { to { opacity: 1; transform: none; } }
  @media (max-width: 640px) {
    .apps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
