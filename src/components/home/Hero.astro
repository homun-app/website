---
import ProductSymbol from "../brand/ProductSymbol.astro";
import DownloadButton from "./DownloadButton.astro";
import { RELEASES_PAGE_URL } from "../../scripts/downloads.mjs";
---

<section id="hero" aria-labelledby="hero-title">
	<div class="stage"><ProductSymbol product="homun" size={270} wake /></div>
	<p class="eyebrow">Open source · Apache-2.0</p>
	<h1 id="hero-title">Your bot team.<br />On your computer.</h1>
	<p class="lead">Give each bot one job. It works on a computer of its own, remembers what matters, and asks before anything goes out.</p>
	<div class="download" data-download-block>
		<div class="ctas">
			<DownloadButton source="hero" />
			<a class="see" href="#showcase">See it work <span aria-hidden="true">↓</span></a>
		</div>
		<div class="platforms" data-hero-platforms>
			<a href={RELEASES_PAGE_URL} data-download-chooser aria-expanded="false" aria-label="Choose an installer for macOS, Windows beta or Linux beta">
				<span class="chip">macOS</span>
				<span class="chip">Windows <span class="beta">beta</span></span>
				<span class="chip">Linux <span class="beta">beta</span></span>
			</a>
		</div>
	</div>
</section>

<style>
	#hero { max-width: 1180px; margin-inline: auto; padding: clamp(36px, 7vh, 80px) 16px 0; text-align: center; }
	.stage { display: grid; place-items: center; height: clamp(170px, 30vh, 310px); }
	.stage :global(svg) { width: clamp(150px, 25vh, 270px); height: auto; }
	.eyebrow { font: .76rem/1.55 var(--mono); letter-spacing: .08em; color: var(--teal-text); }
	h1 { margin-top: 14px; font-size: clamp(2.7rem, 9vw, 6.2rem); }
	.lead { margin: 22px auto 0; max-width: 36ch; font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.55; color: var(--muted); text-wrap: balance; }
	.download { margin-top: 30px; }
	.ctas { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: start; }
	/* Keep the shared resolver and its platform options; the hero supplies its own secondary links. */
	.ctas :global([data-download-block]) { display: contents; }
	.ctas :global([data-download-block] > div:first-child) { width: auto; }
	.ctas :global([data-download-block] > p),
	.ctas :global([data-download-block] .btn-ghost) { display: none; }
	.ctas :global([data-download-options]:not([hidden])) { order: 1; flex-basis: 100%; }
	.ctas :global([data-homun-download]) {
		border-radius: 999px; padding: .85em 1.5em; background: var(--fg);
		color: var(--bg); font: 600 1rem/1.55 var(--body); box-shadow: none;
	}
	.see { padding: .85em .5em; color: var(--teal-text); font-size: 1rem; line-height: 1.55; font-weight: 600; }
	.see:hover, .chip:hover { text-decoration: underline; }
	.platforms { margin-top: 14px; }
	.platforms a { display: inline-flex; flex-wrap: wrap; gap: 8px; justify-content: center; font-size: .86rem; color: var(--muted); }
	.chip { border: 1px solid var(--line); border-radius: 999px; padding: .2em .75em; }
	.beta { font: .66rem var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--teal-text); margin-left: .3em; }

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.stage :global(svg) {
				animation: hero-mascot-exit linear both;
				animation-timeline: scroll(root);
				animation-range: 0 50vh;
			}
		}
		@keyframes hero-mascot-exit { to { scale: .35; translate: 0 -30%; opacity: 0; } }
	}
</style>
