---
import ProductSymbol from "../brand/ProductSymbol.astro";
import StarButton from "../ui/StarButton.astro";
import BotAvatar from "../app/BotAvatar.astro";
import Card from "../app/Card.astro";
import Done from "../app/Done.astro";
import Msg from "../app/Msg.astro";
import Pill from "../app/Pill.astro";
import { fetchStarCount } from "../../lib/github-stars.mjs";
import DownloadButton from "./DownloadButton.astro";
import { RELEASES_PAGE_URL } from "../../scripts/downloads.mjs";

const stars = await fetchStarCount();

// The bots of the window are the app kit's own, with the app's colors.
const bots = [
	{ family: "creature", color: "#F26A2E", name: "Inbox manager", detail: "Draft for Nora is ready" },
	{ family: "robo", color: "#3F7BEA", name: "Scout", detail: "Venue options for Dec 12" },
	{ family: "device", color: "#E7B93A", name: "Daily briefing", detail: "Your Monday in five lines" },
	{ family: "jelly", color: "#E9418A", name: "Account manager", detail: "Acme renewal" },
] as const;
const worksWith = ["Gmail", "Calendar", "Slack", "Notion", "GitHub", "Anthropic", "OpenAI", "Ollama"];
---

<section id="hero" class="hero" aria-labelledby="hero-title">
	<div class="pitch">
		<p class="id">
			<ProductSymbol product="homun" size={44} wake />
			<span>Homun</span>
			<span class="tag">open source · Apache-2.0</span>
		</p>
		<h1 id="hero-title">Your bot team.<br /><em>On your computer.</em></h1>
		<p class="lead">Give each bot one job. It works with your apps and in a computer apart from yours, remembers what matters, and asks before anything goes out. Any model, even fully local.</p>
		<div class="download" data-download-block>
			<div class="ctas">
				<DownloadButton source="hero" />
				<div class="star"><StarButton count={stars} /></div>
				<a class="see" href="#team">See it work <span aria-hidden="true">↓</span></a>
			</div>
			<div class="platforms" data-hero-platforms>
				<span class="row-label">Runs on</span>
				<a href={RELEASES_PAGE_URL} data-download-chooser aria-expanded="false" aria-label="Choose an installer for macOS, Windows beta or Linux beta">
					<span class="chip">macOS</span>
					<span class="chip">Windows <i>beta</i></span>
					<span class="chip">Linux <i>beta</i></span>
				</a>
			</div>
			<p class="row works"><span class="row-label">Works with</span>
				{worksWith.map((name) => <span class="chip">{name}</span>)}
			</p>
		</div>
	</div>

	<div class="app" role="img" aria-label="Homun at work: the Inbox manager sweeps the inbox and leaves a draft that waits for you">
		<aside class="side" aria-hidden="true">
			<p class="lbl">Bots</p>
			{bots.map(({ family, color, name, detail }, index) => (
				<div class:list={["bot", { on: index === 0 }]} data-bot-row>
					<BotAvatar {family} {color} state={index === 0 ? "waiting" : "idle"} size={22} />
					<span><b>{name}</b><small>{detail}</small></span>
				</div>
			))}
			<p class="lbl">Teams</p>
			<div class="bot team" data-team-row>
				<span class="group">
					<BotAvatar family="creature" color="#2FA39A" size={22} mini />
					<BotAvatar family="robo" color="#3F7BEA" size={22} mini />
					<BotAvatar family="creature" color="#F26A2E" size={22} mini />
				</span>
				<span><b>Offsite Dec 12</b><small>Chief of staff · 3 bots</small></span>
			</div>
		</aside>
		<div class="chat">
			<div class="seq" data-motion="now">
				<p class="top">Inbox manager <small>Claude Sonnet · cloud</small></p>
				<Msg from="me" i={1}>Sweep my inbox since Friday. Archive the noise, draft replies, don't send anything.</Msg>
				<Done time="9:02" i={2}>Read 41 threads in Gmail</Done>
				<Done time="9:03" i={3}>Archived 26 newsletters and receipts</Done>
				<Msg from="bot" i={4}>Done. 9 routine threads have draft replies. One needs you: Nora asks if the renewal covers the 5 new seats.</Msg>
				<Card kind="draft" i={5}>
					<Fragment slot="title"><span class="gmail" aria-hidden="true">M</span>Draft for Nora Fields <small>· from work Gmail</small></Fragment>
					<Fragment slot="sub">draft — sent only if you confirm</Fragment>
					<Fragment slot="body">Hi Nora, yes: the renewal covers the new seats from March 1st (section 4.2). Happy to send the updated order form.</Fragment>
					<Fragment slot="buttons"><Pill primary>Send</Pill><Pill>Edit</Pill></Fragment>
				</Card>
				<div class="composer"><span>Message Inbox manager</span><span aria-hidden="true">↑</span></div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, .95fr) minmax(0, 1.1fr);
		gap: clamp(28px, 5vw, 64px);
		align-items: center;
		max-width: 1180px;
		margin-inline: auto;
		padding: calc(55px + clamp(24px, 5vh, 60px)) 16px clamp(64px, 10vh, 120px);
	}

	/* The pitch */
	.id { display: flex; align-items: center; gap: 12px; margin: 0; font: 800 1.5rem var(--display); letter-spacing: -.03em; }
	.id :global(svg) { display: block; }
	.tag { padding: .15em .5em; border-radius: 6px; background: var(--accent-soft); font: .66rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); }
	h1 { margin: 22px 0 0; font-size: clamp(2.5rem, 5.4vw, 4.4rem); }
	h1 em { font-style: normal; color: var(--teal-text); }
	.lead { margin: 20px 0 0; font-size: clamp(1.05rem, 1.8vw, 1.22rem); line-height: 1.55; color: var(--muted); max-width: 46ch; }
	.download { margin-top: 26px; }
	.ctas { display: flex; flex-wrap: wrap; gap: 10px; align-items: start; }
	/* The resolver keeps its own markup; the hero supplies the row links. */
	.ctas :global([data-download-block]) { display: contents; }
	.ctas :global([data-download-block] > div:first-child) { display: contents; }
	.ctas :global([data-homun-download]) {
		border-radius: 999px; padding: .7em 1.25em; background: var(--fg);
		color: var(--bg); font: 600 .95rem/1.55 var(--body); box-shadow: none; white-space: nowrap;
	}
	.ctas :global([data-download-block] > p),
	.ctas :global(.btn-ghost) { display: none; }
	.ctas :global([data-download-options]:not([hidden])) { order: 1; flex-basis: 100%; }
	.star { padding-block: .7em; }
	.see { padding: .7em .5em; color: var(--teal-text); font-size: .95rem; line-height: 1.55; font-weight: 600; }
	.see:hover, .platforms a:hover .chip { text-decoration: underline; }
	.platforms { margin-top: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
	.row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 14px 0 0; font-size: .85rem; }
	.row-label { margin-right: 4px; font: .68rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
	.chip { border: 1px solid var(--line); border-radius: 999px; padding: .2em .75em; }
	.chip i { font-style: normal; font: .6rem var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--teal-text); margin-left: .3em; }

	/* The app at work: a light window, the app kit's own pieces */
	.app {
		display: grid;
		grid-template-columns: 170px minmax(0, 1fr);
		min-height: 440px;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: var(--card);
		box-shadow: 0 40px 90px -40px rgb(10 20 18 / .45);
		overflow: hidden;
		font-size: .86rem;
	}
	.side { display: grid; align-content: start; gap: 4px; padding: 14px 10px; background: var(--surface); border-right: 1px solid var(--line); }
	.lbl { margin: 8px 8px 4px 0; font: .62rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
	.bot { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 8px; align-items: center; padding: 7px 8px; border-radius: 10px; }
	.bot.on { background: var(--card); box-shadow: 0 1px 0 var(--line); }
	.bot b { font-weight: 600; font-size: .8rem; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.bot small { color: var(--muted); font-size: .7rem; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.team { grid-template-columns: auto minmax(0, 1fr); }
	.group { display: flex; }
	.group > :global(span + span) { margin-left: -7px; }
	.chat { display: flex; flex-direction: column; min-width: 0; padding: 14px 16px; }
	.top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin: 0; padding-bottom: 8px; border-bottom: 1px solid var(--line); font-weight: 600; }
	.top small { font: .7rem var(--mono); color: var(--muted); font-weight: 400; }
	.seq { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
	.seq :global(.gmail) { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 5px; background: #EA4335; color: #101917; font-size: 10px; font-weight: 700; }
	.seq :global([data-card="draft"]) { max-width: 92%; box-shadow: none; }
	.seq :global([data-pill]) { border: 0; backdrop-filter: none; }
	.composer { margin-top: auto; display: flex; justify-content: space-between; border: 1px solid var(--line); border-radius: 14px; padding: 9px 12px; color: var(--muted); font-size: .8rem; }

	/* The window plays once, from load; without JavaScript it is already there. */
	@media (prefers-reduced-motion: no-preference) {
		:global(html.js) .seq:not(.in) > * {
			opacity: 0;
			transform: translateY(6px);
		}
		.seq.in > * {
			animation: f-line .45s ease forwards;
			animation-delay: calc(var(--i, 0) * .55s + .4s);
		}
		.seq.in > :global([data-card="draft"]) {
			animation: f-line .45s ease forwards, f-glow 1.2s ease 3.4s 2;
		}
	}

	@media (max-width: 980px) {
		.hero { grid-template-columns: minmax(0, 1fr); align-items: start; }
	}
	@media (max-width: 640px) {
		.app { grid-template-columns: minmax(0, 1fr); min-height: 0; }
		.side { display: none; }
	}
</style>
