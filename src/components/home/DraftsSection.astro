---
import FeatureSection from "./FeatureSection.astro";
import Surface from "../app/Surface.astro";
import Card from "../app/Card.astro";
import Pill from "../app/Pill.astro";
import Done from "../app/Done.astro";

const drafts = [
  { name: "Nora Fields", reply: "Hi Nora, yes: the renewal covers the new seats from March 1st (section 4.2). Happy to send the updated order form." },
  { name: "Marco Bassi", reply: "Thursday at 3 works. I've added the call to your calendar as tentative." },
];
---

<FeatureSection id="drafts" eyebrow="Inbox manager" title="It does the work. You press Send."
  lead="It reads Gmail through the apps you connected. Replies wait in the chat as drafts: edit them, send them, or let them go.">
  <Surface slot="visual" bot={{ name: "Inbox manager", family: "creature", color: "#F26A2E", state: "speaking" }} status="9:04">
    {drafts.map(({ name, reply }, i) => (
      <Card kind="draft" {i}>
        <Fragment slot="title"><span class="gmail" aria-hidden="true">M</span>Draft for {name} <small>· from work Gmail</small></Fragment>
        <Fragment slot="sub">draft — sent only if you confirm</Fragment>
        <Fragment slot="body">{reply}</Fragment>
        {i === 0 && <Fragment slot="buttons"><Pill primary class="press">Send</Pill><Pill>Edit</Pill></Fragment>}
      </Card>
    ))}
    <Done i={2}>7 more drafts in Gmail · nothing sent</Done>
  </Surface>
</FeatureSection>

<style>
  .gmail { width: 18px; height: 18px; border-radius: 5px; display: grid; place-items: center; background: #EA4335; color: #101917; font-size: 10px; font-weight: 700; }
</style>
