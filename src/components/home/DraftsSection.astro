---
import DeepDive from "../family/DeepDive.astro";
import Card from "../app/Card.astro";
import Done from "../app/Done.astro";
import Pill from "../app/Pill.astro";

const drafts = [
  { name: "Nora Fields", reply: "Hi Nora, yes: the renewal covers the new seats from March 1st (section 4.2). Happy to send the updated order form." },
  { name: "Marco Bassi", reply: "Thursday at 3 works. I've added the call to your calendar as tentative." },
];
---

<DeepDive id="drafts" product="homun" tight eyebrow="Drafts" title="It does the work. You press Send."
  lead="It reads Gmail through the apps you connected. Replies wait in the chat as drafts: edit them, send them, or let them go."
  chips={["sent only if you confirm", "Send · Edit · Discard", "two accounts, named"]}>
  <div slot="visual" class="stack" data-motion="">
    {drafts.map(({ name, reply }, i) => (
      <Card kind="draft" {i}>
        <Fragment slot="title"><span class="gmail" aria-hidden="true">M</span>Draft for {name} <small>· from work Gmail</small></Fragment>
        <Fragment slot="sub">draft — sent only if you confirm</Fragment>
        <Fragment slot="body">{reply}</Fragment>
        {i === 0 && <Fragment slot="buttons"><Pill primary>Send</Pill><Pill>Edit</Pill></Fragment>}
      </Card>
    ))}
    <Done i={2}>7 more drafts awaiting your click</Done>
  </div>
</DeepDive>

<style>
  .stack { display: grid; gap: 10px; }
  .gmail { width: 18px; height: 18px; border-radius: 5px; display: inline-grid; place-items: center; background: #EA4335; color: #101917; font-size: 10px; font-weight: 700; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .stack:not(.in) > * { opacity: 0; transform: translateY(10px); }
    .stack.in > * { animation: f-line .5s ease forwards; }
    .stack.in > :nth-child(2) { animation-delay: .35s; }
    .stack.in > :nth-child(3) { animation-delay: .7s; }
  }
</style>
