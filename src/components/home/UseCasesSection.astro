---
import BotAvatar from "../app/BotAvatar.astro";

const cases = [
	{
		audience: "Founders", family: "creature", color: "#F26A2E",
		prompt: "Every morning, get my inbox to zero and leave me only what needs me.",
		details: "Gmail · drafts held for you · a routine at 7:00",
		template: "Inbox manager",
	},
	{
		audience: "Busy weeks", family: "device", color: "#E7B93A",
		prompt: "Before every call, tell me who I’m meeting and what we promised them.",
		details: "Calendar · Gmail · memory of past calls",
		template: "Meeting preparation assistant",
	},
	{
		audience: "Sales", family: "robo", color: "#3F7BEA",
		prompt: "Research these 40 accounts and draft a first email for each. Don’t send.",
		details: "Web search · its own browser · HubSpot",
	},
	{
		audience: "Freelancers", family: "jelly", color: "#E9418A",
		prompt: "Match my receipts to card payments and tell me what’s missing for my accountant.",
		details: "Gmail · files in the Library · a Friday routine",
	},
	{
		audience: "Teams of bots", family: "creature", color: "#2FA39A",
		prompt: "Plan the offsite: venue, invites and a budget. Bring me one summary.",
		details: "A coordinator with two helpers in a group",
		template: "Chief of staff",
	},
	{
		audience: "Developers", family: "robo", color: "#8A5CF0",
		prompt: "Watch new GitHub issues, reproduce the bugs in its computer and write down the steps.",
		details: "GitHub · terminal in its own computer",
	},
] as const;
---

<section id="uses" class="uses-section" data-product="homun" aria-labelledby="uses-title">
	<div class="f-wrap">
		<div class="f-head">
			<p class="f-eyebrow">What people use it for</p>
			<h2 id="uses-title">One job each. Here are a few.</h2>
			<p class="f-lead">Each one is a sentence you can type into a new bot today.</p>
		</div>
		<div class="uses" data-motion="">
			{cases.map(({ audience, family, color, prompt, details, ...item }) => (
				<article class="use">
					<p class="who"><BotAvatar {family} {color} size={22} />{audience}</p>
					<p class="prompt">{prompt}</p>
					<small>{details}</small>
					<span class="tag">{"template" in item ? `Template · ${item.template}` : "Ask in your own words"}</span>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.uses-section { padding-block: clamp(80px, 12vh, 140px); }
	.uses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
	.use { display: grid; gap: 10px; align-content: start; padding: 20px; border: 1px solid var(--line); border-radius: 20px; background: var(--card); }
	.who { display: flex; align-items: center; gap: 8px; margin: 0; font: .68rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent-text); }
	.prompt { margin: 0; font: 700 1.05rem/1.35 var(--body); }
	.use small { color: var(--muted); font-size: .82rem; }
	.tag { justify-self: start; padding: .15em .5em; border-radius: 6px; background: var(--accent-soft); font: .66rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); white-space: nowrap; }
	@media (prefers-reduced-motion: no-preference) {
		:global(html.js) .uses:not(.in) > * { opacity: 0; transform: translateY(10px); }
		.uses.in > * { animation: f-line .5s ease forwards; }
		.uses.in > :nth-child(2) { animation-delay: .12s; }
		.uses.in > :nth-child(3) { animation-delay: .24s; }
		.uses.in > :nth-child(4) { animation-delay: .36s; }
		.uses.in > :nth-child(5) { animation-delay: .48s; }
		.uses.in > :nth-child(6) { animation-delay: .6s; }
	}
	@media (max-width: 980px) {
		.uses { grid-template-columns: minmax(0, 1fr); }
	}
</style>
