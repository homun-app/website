---
import { CORE_REPOSITORY_URL, RELEASES_PAGE_URL, downloadLabel, platformBadge, platformRequirement } from "../../scripts/downloads.mjs";
import { buildTimeOffer } from "../../lib/download-offer.mjs";

interface Props {
	source: string;
	template?: string;
	closing?: boolean;
}

const { source, template, closing = false } = Astro.props;
// The chips and the badges come from the release on offer, not from a
// hand-written list: while the beta ships an arm64 macOS .dmg only, macOS
// says «beta · Apple Silicon» and the others say «soon».
const offer = buildTimeOffer();
const platformTargets = [
	{ platform: "macos", label: "macOS" },
	{ platform: "windows", label: "Windows" },
	{ platform: "linux", label: "Linux" },
].map(({ platform, label }) => ({
	platform,
	label,
	badge: platformBadge(platform, offer),
	requirement: platformRequirement(platform, offer),
}));
// The closing button states its platform outright: the first one the offered
// release actually ships.
const ctaPlatform = ["macos", "windows", "linux"].find((platform) => offer.available[platform]) ?? null;
const ctaLabel = ctaPlatform ? downloadLabel(ctaPlatform, offer) : "Get Homun";
---

<div data-download-block class="flex w-full flex-col items-center">
	<div class="flex w-full flex-col items-stretch justify-center gap-3 sm:w-auto sm:flex-row sm:items-center">
		<a
			data-homun-download
			data-analytics-download-source={source}
			data-analytics-template={template}
			href={RELEASES_PAGE_URL}
			class:list={["btn btn-primary", closing ? "closing-cta" : "w-full sm:w-auto"]}
		>
			{closing ? ctaLabel : "Download"}
		</a>
		{!closing && <a href={CORE_REPOSITORY_URL} class="btn btn-ghost w-full sm:w-auto">Star on GitHub</a>}
	</div>

	{closing ? (
		<a class="platforms" href={RELEASES_PAGE_URL} data-download-chooser aria-expanded="false">
			{platformTargets.map(({ label, badge, requirement }) => (
				<span class="chip">{label}{badge && <span class="beta"> {badge}</span>}{requirement && <span class="arch"> {requirement}</span>}</span>
			))}
		</a>
	) : (
		<p class="mt-4 text-center text-sm text-faint">
			<a class="link-accent" href={RELEASES_PAGE_URL} data-download-chooser aria-expanded="false">Other platforms</a>
		</p>
	)}

	<div
		data-download-options
		hidden
		class="mt-4 w-full max-w-md rounded-2xl border border-line bg-surface/70 p-4"
	>
		<div class="grid gap-2">
			{platformTargets.map(({ platform, label, badge, requirement }) => (
				<a
					data-download-platform={platform}
					href={RELEASES_PAGE_URL}
					class="flex items-center justify-between rounded-xl border border-line bg-bg/45 px-4 py-3 text-sm text-muted transition-colors hover:border-line-strong hover:text-cream"
				>
					<span>
						{label}{badge && <span class="beta"> {badge}</span>}
						{requirement && <small class="block">{requirement}</small>}
					</span>
					<span class="text-accent-bright" aria-hidden="true">↓</span>
				</a>
			))}
			<button
				data-share-link
				type="button"
				class="flex items-center justify-between rounded-xl border border-line bg-bg/45 px-4 py-3 text-sm text-muted transition-colors hover:border-line-strong hover:text-cream"
			>
				<span data-share-label>Share or copy the link</span>
				<span class="text-accent-bright" aria-hidden="true">↗</span>
			</button>
		</div>
	</div>
</div>

<style>
	.closing-cta { align-self: center; border-radius: 999px; padding: .85em 1.5em; background: var(--fg); color: var(--bg); font: 600 1rem/1.55 var(--body); box-shadow: none; }
	.platforms { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; font-size: .86rem; color: var(--muted); }
	.chip { border: 1px solid var(--line); border-radius: 999px; padding: .2em .75em; }
	.platforms:hover .chip { text-decoration: underline; }
	.beta { margin-inline-start: .3em; color: var(--teal-text); font: .66rem var(--mono); letter-spacing: .06em; text-transform: uppercase; }
	.arch { margin-inline-start: .3em; color: var(--muted); }
</style>
