---
import AppWindow from "../ui/AppWindow.astro";
import ApprovalCard from "../ui/ApprovalCard.astro";
import ChatMessage from "../ui/ChatMessage.astro";
import SceneSection from "../ui/SceneSection.astro";
---

<!-- "Its own computer" scene: a bot works freely inside its sandboxed Docker
     computer (the Computer panel follows along) and only stops when a step
     has to leave it — the approval card is where the user sets the limits.
     Stacked layout so the window, chat and Computer panel all get room. -->
<SceneSection
	id="computer"
	layout="stacked"
	eyebrow="Its own computer"
	title="It works alone. You set the limits."
	body="Every bot gets a sandboxed computer of its own — a Docker container where it installs tools, writes scripts and does its work. When a step has to leave the sandbox, an approval card stops it: allow once, always allow, or deny."
>
	<AppWindow title="homun · inbox manager" botName="Inbox manager" botEmoji="📬" computer>
		<ChatMessage from="system">⏱ invoice round · 14:00</ChatMessage>
		<ChatMessage from="bot">14 invoices in, filenames all over the place — moving the work into my computer</ChatMessage>
		<ChatMessage from="bot">installed a pdf tool, wrote the rename script — it all stays inside the sandbox</ChatMessage>
		<ChatMessage from="bot">done — 14 sorted, recap ready. sending it needs your ok</ChatMessage>
		<ApprovalCard tool="gmail" detail="Send the invoice recap to the accounting inbox" state="pending" />
		<ChatMessage from="user">allow once</ChatMessage>
		<ChatMessage from="bot" status="done">sent — and it will ask again next time</ChatMessage>
		<div slot="computer" class="flex flex-col gap-2 font-mono text-[11px] leading-relaxed text-muted">
			<p class="flex items-center gap-2 text-faint"><span class="status-dot"></span> sandbox · docker</p>
			<p>$ pip install pdfkit</p>
			<p class="text-accent-bright">✓ installed in the sandbox</p>
			<p>$ python rename.py</p>
			<p class="text-accent-bright">✓ 14 files renamed</p>
		</div>
	</AppWindow>
</SceneSection>
