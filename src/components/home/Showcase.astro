---
import AppWindow from "../app/AppWindow.astro";
import BotAvatar from "../app/BotAvatar.astro";
import Card from "../app/Card.astro";
import ComputerScreen from "../app/ComputerScreen.astro";
import Done from "../app/Done.astro";
import Msg from "../app/Msg.astro";
import Pill from "../app/Pill.astro";

const bots = [
	{ family: "creature", color: "#F26A2E", name: "Inbox manager", detail: "Draft for Nora is ready" },
	{ family: "robo", color: "#3F7BEA", name: "Scout", detail: "Venue options for Dec 12" },
	{ family: "device", color: "#E7B93A", name: "Daily briefing", detail: "Your Monday in five lines" },
	{ family: "jelly", color: "#E9418A", name: "Account manager", detail: "Acme renewal" },
] as const;
const inbox = bots[0];
---

<section id="showcase" class="timeline-show" aria-label="The Homun app">
	<AppWindow class="reveal-window">
		<Fragment slot="sidebar">
			<div class="tools" aria-hidden="true"><span>⌕</span><span>+</span></div>
			{bots.map(({family, color, name, detail}, index) => (
				<div class:list={["row", { active: index === 0 }]} data-bot-row>
					<BotAvatar {family} {color} state={index === 0 ? "waiting" : "idle"} />
					<div><b>{name}</b><small>{detail}</small></div>
				</div>
			))}
			<p class="section-label">Teams</p>
			<div class="row" data-team-row>
				<div class="group">
					<BotAvatar family="creature" color="#2FA39A" size={22} mini />
					<BotAvatar family="robo" color="#3F7BEA" size={22} mini />
					<BotAvatar family="creature" color="#F26A2E" size={22} mini />
				</div>
				<div><b>Offsite Dec 12</b><small>Chief of staff · 3 bots</small></div>
			</div>
			<div class="app-nav"><span>〜 Activity</span><span>▤ Library</span></div>
			<div class="account"><span class="initials">AK</span><div>Avery Kim<small>Claude Sonnet · cloud</small></div></div>
		</Fragment>

		<Fragment slot="chat">
			<div class="chat-head"><BotAvatar family={inbox.family} color={inbox.color} size={24} />{inbox.name}</div>
			<div class="thread">
				<Msg from="me" i={0}>Sweep my inbox since Friday. Archive the noise, draft replies, don't send anything.</Msg>
				<Done time="9:02" i={1}>Read 41 threads in Gmail</Done>
				<Done time="9:03" i={2}>Archived 26 newsletters and receipts</Done>
				<Msg from="bot" i={3}>Done. 9 routine threads have draft replies. One needs you: Nora asks if the renewal covers the 5 new seats.</Msg>
				<Card kind="draft" i={4} class="nora-draft">
					<Fragment slot="title"><span class="gmail" aria-hidden="true">M</span>Draft for Nora Fields <small>· from work Gmail</small></Fragment>
					<Fragment slot="sub">draft — sent only if you confirm</Fragment>
					<Fragment slot="body">Hi Nora, yes: the renewal covers the new seats from March 1st (section 4.2). Happy to send the updated order form.</Fragment>
					<Fragment slot="buttons"><Pill primary>Send</Pill><Pill>Edit</Pill></Fragment>
				</Card>
			</div>
			<div class="composer"><span aria-hidden="true">⌁</span> Message Inbox manager<span class="send" aria-hidden="true">↑</span></div>
		</Fragment>

		<Fragment slot="panel">
			<BotAvatar family={inbox.family} color={inbox.color} state="waiting" size={104} />
			<h2>{inbox.name}</h2>
			<p class="model">Model: <b>Claude Sonnet</b> ›</p>
			<div class="tabs"><span class="active">Activity</span><span>Library</span><span>Memory</span></div>
			<ComputerScreen state="Off" />
			<div class="listing"><div><span>Routines</span><span>All ›</span></div><p>Morning sweep · weekdays 7:00</p></div>
			<div class="listing"><div>Recent work</div><p>Archived 26 · drafted 9</p></div>
		</Fragment>
	</AppWindow>
</section>

<style>
	#showcase { max-width: 1180px; margin-inline: auto; padding: 70px 16px 40px; scroll-margin-top: 56px; }
	.tools { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 6px; }
	.tools span, .initials { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--a-muted); }
	.tools span { color: var(--a-mfg); font-size: 15px; }
	.section-label { padding: 10px 8px 4px; font-size: 11.5px; color: var(--a-mfg); }
	.row { display: flex; align-items: center; gap: 10px; padding: 7px 8px; border-radius: 12px; }
	.row.active, .tabs .active { background: var(--a-muted); }
	.row b { display: block; font-size: 13.5px; font-weight: 600; }
	.row small, .account small { display: block; color: var(--a-mfg); font-size: 12px; }
	.group { display: flex; padding-right: 7px; }
	.group > :global(span + span) { margin-left: -7px; }
	.app-nav { display: grid; gap: 2px; margin-top: 6px; font-size: 13.5px; }
	.app-nav span { padding: 7px 10px; }
	.account { display: flex; align-items: center; gap: 10px; margin-top: auto; padding: 8px; font-size: 13.5px; }
	.initials { font-size: 11px; font-weight: 600; }
	.chat-head { justify-self: center; display: flex; align-items: center; gap: 8px; margin-top: 10px; padding: 5px 14px 5px 8px; border-radius: 99px; background: var(--a-card); box-shadow: 0 1px 0 var(--a-line); font-size: 13.5px; font-weight: 600; }
	.thread { display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; min-height: 0; padding: 14px 26px; overflow: hidden; }
	.thread :global(.nora-draft) { max-width: 86%; border: 0; box-shadow: none; }
	.thread :global([data-pill]) { border: 0; backdrop-filter: none; }
	.gmail { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 5px; background: #EA4335; color: #1E1C18; font-size: 10px; font-weight: 700; }
	.composer { display: flex; align-items: center; gap: 12px; margin: 0 24px 14px; padding: 8px 8px 8px 16px; border-radius: 22px; background: var(--a-card); color: var(--a-mfg); box-shadow: 0 0 0 1px var(--a-line); }
	.send { display: grid; place-items: center; width: 34px; height: 34px; margin-left: auto; border-radius: 50%; background: var(--a-mfg); color: var(--a-bg); }
	h2 { font-size: 24px; letter-spacing: -.02em; }
	.model { font-size: 12px; color: var(--a-mfg); }
	.model b { font-weight: 500; color: var(--a-fg); }
	.tabs { display: flex; gap: 4px; font-size: 13px; }
	.tabs span { padding: 5px 12px; border-radius: 99px; }
	.tabs .active { font-weight: 600; }
	.listing { display: grid; gap: 5px; width: 100%; font-size: 13.5px; }
	.listing div { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--a-mfg); }
</style>
