---
import FeatureSection from "./FeatureSection.astro";
import Surface from "../app/Surface.astro";
import Msg from "../app/Msg.astro";
import Card from "../app/Card.astro";
import Pill from "../app/Pill.astro";
---

<FeatureSection id="approvals" eyebrow="Approvals" layout="center" title="It asks before it goes too far."
  lead="Reads that serve your request just happen. Writing to someone new, paying or deleting waits for you.">
  <div slot="visual" class="approval">
    <Surface bot={{ name: "Scout", family: "robo", color: "#3F7BEA", state: "waiting" }} status="waiting for you">
      <Msg from="bot" i={0}>Sala Navigli fits: 24 seats, €1,800, free on the 12th. Their site only takes requests through a form.</Msg>
      <Card kind="approval" i={1}>
        <Fragment slot="title"><span class="question">Send the booking request on salanavigli.it?</span></Fragment>
        <Fragment slot="sub"><span class="details">It writes to someone you haven't named. Your name, email and the date go in the form.</span></Fragment>
        <Fragment slot="buttons">
          <Pill primary class="press">Allow</Pill>
          <Pill>For this turn</Pill>
          <Pill>Always allow</Pill>
          <Pill>Deny</Pill>
        </Fragment>
      </Card>
    </Surface>
  </div>
</FeatureSection>

<style>
  .approval { max-width: 460px; margin-inline: auto; }
  .approval :global([data-from]) { font-size: 15px; }
  .question { font-size: 16px; }
  .details { font-size: 13.5px; }
  .approval :global([data-pill]) { font-size: 14px; padding: 8px 15px; }
</style>
