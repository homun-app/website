---
import FeatureSection from "./FeatureSection.astro";
import Surface from "../app/Surface.astro";
import Msg from "../app/Msg.astro";
import Card from "../app/Card.astro";
import Pill from "../app/Pill.astro";

const mondays = ["Mon 27", "Mon 3", "Mon 10"];
const restOfWeek = ["Tue", "Wed", "Thu", "Fri"];
---

<FeatureSection id="routines" eyebrow="Routines" title="It notices what you repeat."
  lead="Three Mondays in a row? It offers a routine. Nothing runs until you press Activate. It can also wake up on a schedule or when something changes.">
  <div slot="visual" class="routine">
    <Surface bot={{ name: "Daily briefing", family: "device", color: "#E7B93A", state: "happy" }} status="runs on a local model">
      {mondays.map((monday, i) => (
        <div class="week play" style={{ "--i": i }}>
          <div class="asked"><b>{monday}</b>asked</div>
          {restOfWeek.map((day) => <div><b>{day}</b>—</div>)}
        </div>
      ))}
      <Msg from="bot" i={3}>You've asked me for this three Mondays in a row. Want it every weekday?</Msg>
      <Card kind="routine" i={4}>
        <Fragment slot="title">New routine · Morning briefing</Fragment>
        <Fragment slot="sub">Weekdays at 8:00 · Europe/Rome · writes to you here</Fragment>
        <Fragment slot="buttons">
          <Pill primary class="press">Activate</Pill>
          <Pill>Change time</Pill>
        </Fragment>
      </Card>
    </Surface>
  </div>
</FeatureSection>

<style>
  .routine :global([data-surface]) { gap: 14px; }
  .week { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .week > div {
    display: grid;
    gap: 4px;
    background: var(--a-card);
    border-radius: 10px;
    padding: 8px clamp(4px, 1.2vw, 8px);
    font-size: 12px;
    color: var(--a-mfg);
  }
  .week b { color: var(--a-fg); font-size: 13px; }
  .asked { box-shadow: 0 0 0 2px var(--teal); }
</style>
