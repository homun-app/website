---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
	lead: string;
	layout?: "split" | "flip" | "center";
	tone?: "default" | "band";
}
const { id, eyebrow, title, lead, layout = "split", tone = "default" } = Astro.props;
---

<section {id} class:list={["feature", "timeline-f", layout, tone]} aria-labelledby={`${id}-title`}>
	<div class="feature-grid">
		<div class="section-text">
			<p class="feature-eyebrow">{eyebrow}</p>
			<h2 id={`${id}-title`}>{title}</h2>
			<p class="lead">{lead}</p>
		</div>
		<div class="section-visual"><slot name="visual" /></div>
	</div>
</section>

<style>
	.feature { padding-block: clamp(90px, 14vh, 160px); }
	.feature-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(28px, 6vw, 90px); max-width: 1180px; margin-inline: auto; padding-inline: 16px; }
	.section-text { display: grid; gap: 18px; }
	.section-visual { min-width: 0; width: 100%; }
	.flip .feature-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); }
	.flip .section-text { order: 2; }
	.center .feature-grid { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
	.center .lead { margin-inline: auto; text-wrap: balance; }
	h2 { font-size: clamp(2.1rem, 5.6vw, 4.2rem); }
	.feature-eyebrow { font: .76rem/1.55 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--teal-text); }
	.lead { font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.55; color: var(--muted); max-width: 36ch; }
	.band { background: var(--band); color: var(--band-fg); }
	.band .feature-eyebrow { color: #8EA3F2; }
	.band .lead { color: var(--band-muted); }
	@media (max-width: 820px) {
		.feature-grid, .flip .feature-grid { grid-template-columns: minmax(0, 1fr); }
		.flip .section-text { order: 0; }
	}
</style>
