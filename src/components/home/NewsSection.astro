---
// The releases and the roadmap of the homepage: the family's block, fed by the
// two snapshots that sync from GitHub (src/lib/releases-roadmap.mjs). The beta
// channel is public record here, as one line marked «beta» that leads to the
// changelog; the download buttons still resolve to stable releases only.
import ReleasesRoadmap from "../family/ReleasesRoadmap.astro";
import roadmapSnapshot from "../../data/roadmap.json";
import releaseSnapshot from "../../data/releases.json";
import { homeRoadmap } from "../../lib/releases-roadmap.mjs";
import { RELEASES_PAGE_URL } from "../../scripts/downloads.mjs";

const { shipped, now, next, later, progress } = homeRoadmap(releaseSnapshot, roadmapSnapshot);
---

<section id="roadmap" class="news f-band" data-product="homun" data-tone="band" aria-labelledby="roadmap-title">
	<div class="inner">
		<div class="f-head loud">
			<p class="f-eyebrow">Releases and roadmap</p>
			<h2 id="roadmap-title">Where Homun is going.</h2>
			<p class="f-lead">What shipped — the open beta marked as such, then the stable releases that have a title — and what we’re building next. Open source, so you can follow every change.</p>
		</div>
		<ReleasesRoadmap product="homun" shipped={shipped} now={now} next={next} later={later} progress={progress} />
		<nav class="more" aria-label="Releases and roadmap">
			<a href={RELEASES_PAGE_URL}>All releases →</a>
			<a href="/changelog/">Full changelog →</a>
			<a href="/roadmap/">Roadmap and votes →</a>
		</nav>
	</div>
</section>

<style>
	.news { padding-block: clamp(90px, 14vh, 160px); }
	.inner { max-width: 1180px; margin-inline: auto; padding-inline: 16px; }
	.more { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 36px; font-weight: 600; }
	.more a { color: var(--accent-text); }
	.more a:hover { text-decoration: underline; text-underline-offset: .18em; }
</style>
