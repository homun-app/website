---
import { NEWS } from "../../data/news.mjs";
import { ROADMAP } from "../../data/home-roadmap.mjs";
import { RELEASES_PAGE_URL } from "../../scripts/downloads.mjs";

const dateFormat = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const lanes = [
	{ name: "Now", label: "In progress", items: ROADMAP.now },
	{ name: "Next", label: "Coming soon", items: ROADMAP.next },
	{ name: "Later", label: "Exploring", items: ROADMAP.later },
];
---

<section id="news" class="timeline-f" aria-labelledby="news-title">
	<header class="section-text">
		<p class="eyebrow">Shipping every week</p>
		<h2 id="news-title">Where Homun is going.</h2>
		<p class="lead">The latest releases, and what we’re building next. Open source, so you can follow every change.</p>
	</header>
	<div class="news">
		<div>
			{NEWS.map(({ version, date, title, body, prerelease }) => (
				<article class="release rise-self" data-news-version={version}>
					<div class="release-meta">
						<time datetime={date}>{dateFormat.format(new Date(date))}</time>
						<span aria-hidden="true"> · </span>
						{version}{prerelease && <span class="badge" data-release-badge>beta</span>}
					</div>
					<h3><a href={`${RELEASES_PAGE_URL}/tag/${version}`}>{title}</a></h3>
					<p>{body}</p>
				</article>
			))}
		</div>
		<div class="roadmap">
			{lanes.map(({ name, label, items }) => (
				<div class="lane rise-self" data-roadmap-lane={name}>
					<h3><span class="badge">{name}</span>{label}</h3>
					<ul>
						{items.map(({ title, body }) => <li>{title}<small>{body}</small></li>)}
					</ul>
				</div>
			))}
		</div>
	</div>
	<div class="more-links">
		<a href="/changelog">Full changelog →</a>
		<a href="/roadmap">Roadmap →</a>
	</div>
</section>

<style>
	#news { max-width: 1180px; margin-inline: auto; padding: clamp(90px, 14vh, 160px) 16px; }
	header { display: grid; gap: 18px; }
	h2 { font-size: clamp(2.1rem, 5.6vw, 4.2rem); }
	.eyebrow { font: .76rem/1.55 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--teal-text); }
	.lead { font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--muted); max-width: 36ch; }
	.news { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(20px, 4vw, 48px); margin-top: 48px; }
	.release { display: grid; gap: 4px; padding-block: 16px; border-top: 1px solid var(--line); }
	.release-meta { font: .74rem/1.55 var(--mono); color: var(--muted); }
	.release h3 { font: 600 1rem/1.4 var(--body); letter-spacing: normal; }
	.release p { color: var(--muted); font-size: .95rem; }
	.roadmap { display: grid; gap: 12px; }
	.lane { display: grid; gap: 10px; padding: 16px 18px; border-radius: 18px; background: var(--surface); }
	.lane h3 { display: flex; gap: 8px; align-items: center; font-size: 1.05rem; }
	.badge { padding: 3px 8px; border-radius: 6px; background: var(--bg); color: var(--teal-text); font: .68rem/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
	.release .badge { margin-inline-start: .4em; }
	.lane ul { display: grid; gap: 8px; font-size: .95rem; }
	.lane small { display: block; color: var(--muted); font-size: .84rem; }
	.more-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 20px; color: var(--teal-text); font-weight: 600; }
	a:hover { text-decoration: underline; }
	@media (max-width: 820px) { .news { grid-template-columns: minmax(0, 1fr); } }
</style>
