---
import Page from "../layouts/Page.astro";
import ProductSymbol from "../components/brand/ProductSymbol.astro";
import EngrammaMark from "../components/brand/EngrammaMark.astro";
import FeatureSection from "../components/home/FeatureSection.astro";
import Surface from "../components/app/Surface.astro";
import Msg from "../components/app/Msg.astro";
import MemoryNote from "../components/engramma/MemoryNote.astro";
import CommandBlock from "../components/engramma/CommandBlock.astro";
import HowItWorks from "../components/engramma/HowItWorks.astro";
import ConnectClients from "../components/engramma/ConnectClients.astro";
import Trust from "../components/engramma/Trust.astro";
import EngrammaRoadmap from "../components/engramma/EngrammaRoadmap.astro";
import { ENGRAMMA_RELEASE, ENGRAMMA_INSTALL_COMMAND, ENGRAMMA_FIRST_COMMANDS, ENGRAMMA_WORKS_WITH } from "../data/engramma.mjs";
---

<Page title="Engramma · Memory for assistants" description="An open-source memory engine for assistants: readable notes with sources and dates, a search that explains itself, on your computer. Developer preview for Claude, ChatGPT, Cursor and other MCP clients.">
	<section id="hero" aria-labelledby="engramma-title">
		<ProductSymbol product="engramma" size={190} />
		<h1 id="engramma-title"><EngrammaMark /></h1>
		<p class="signature">a homun product</p>
		<p class="status">Developer preview {ENGRAMMA_RELEASE.version} · also inside Homun</p>
		<p class="hero-lead">Memory your assistant can search and you can read. Open source, on your computer, for any MCP client.</p>
		<div class="install" id="install">
			<CommandBlock label="Install · macOS and Linux" code={ENGRAMMA_INSTALL_COMMAND} />
			<ul class="platforms" aria-label="Platforms">
				{ENGRAMMA_RELEASE.platforms.map(({ label, shipped }) => (
					<li class:list={["chip", { later: !shipped }]}>{label}{!shipped && <span class="tag"> not yet</span>}</li>
				))}
			</ul>
			<details>
				<summary>Then try it</summary>
				<CommandBlock label="Terminal" code={ENGRAMMA_FIRST_COMMANDS} />
			</details>
			<p class="note">The macOS binary is not signed yet: the terminal installer is not blocked by Gatekeeper, a file downloaded from the browser is. A beta: the command line can still change, and memory written by this version opens in every later one (<a href={ENGRAMMA_RELEASE.compatibilityUrl}>the compatibility promise</a>).</p>
		</div>
		<p class="works"><span>Works with</span>{ENGRAMMA_WORKS_WITH.map((name) => <a href="#connect">{name}</a>)}</p>
		<nav class="jump" aria-label="On this page">
			<a href="#how">How it works</a>
			<a href="#different">Why Engramma</a>
			<a href="#connect">Connect your assistant</a>
			<a href="#roadmap">Roadmap</a>
			<a href={ENGRAMMA_RELEASE.releaseUrl}>Release notes</a>
			<a href={ENGRAMMA_RELEASE.repository}>GitHub</a>
		</nav>
	</section>

	<HowItWorks />
	<FeatureSection id="remembers" eyebrow="Remembers" title="Find the detail you told it." lead="Engramma keeps what an assistant learns in readable notes. Search can find a note even when you ask in different words.">
		<Surface slot="visual" title="Memory search">
			<Msg from="me" i={0}>What length of contract does Acme accept?</Msg>
			<MemoryNote detail="Source: you · Stated" i={1}>Acme only signs annual contracts.</MemoryNote>
		</Surface>
	</FeatureSection>
	<FeatureSection id="time" layout="flip" eyebrow="Time" title="Ask what was true then." lead="When a fact changes, the earlier version stays in the history. You can search for what was true on a particular date.">
		<Surface slot="visual" title="Office location">
			<MemoryNote detail="Valid from September 2026" i={0}>The office is in Milano.</MemoryNote>
			<MemoryNote detail="Valid until September 2026 · Superseded" i={1}>The office was in Torino.</MemoryNote>
		</Surface>
	</FeatureSection>
	<FeatureSection id="sources" eyebrow="Sources" title="See where an answer came from." lead="Notes record their source and confidence. Search results explain why each note matched.">
		<Surface slot="visual" title="Why this note matched">
			<MemoryNote detail="Source: you · Confidence: stated" i={0}>Acme only signs annual contracts.</MemoryNote>
			<Msg from="bot" i={1}>Matched the note about Acme’s contract terms.</Msg>
		</Surface>
	</FeatureSection>
	<FeatureSection id="quarantine" layout="flip" tone="band" eyebrow="Quarantine" title="Unconfirmed claims wait for you." lead="Information taken or inferred from third parties stays out of search results until a person confirms it.">
		<Surface slot="visual" title="Quarantined note">
			<MemoryNote detail="Source: website · Waiting for your confirmation" i={0} pending>Acme’s CFO is leaving in March.</MemoryNote>
		</Surface>
	</FeatureSection>
	<ConnectClients />
	<Trust />
	<EngrammaRoadmap />
</Page>

<style>
	#hero { display: grid; justify-items: center; gap: 16px; padding: clamp(48px, 9vh, 100px) 16px 32px; text-align: center; }
	h1 { display: grid; justify-items: center; width: 100%; }
	.signature, .status { font: .78rem/1.6 var(--mono); color: var(--muted); }
	.status { background: var(--surface); border-radius: 16px; padding: 5px 12px; }
	.hero-lead { font-size: clamp(1.05rem, 2vw, 1.25rem); max-width: 40ch; }
	.install { display: grid; gap: 12px; width: 100%; max-width: 760px; margin-top: 12px; text-align: left; }
	.platforms { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; padding: 0; margin: 0; list-style: none; font-size: .82rem; color: var(--muted); }
	.chip { border: 1px solid var(--line); border-radius: 999px; padding: .2em .75em; }
	.later { opacity: .6; }
	.tag { font: .66rem var(--mono); letter-spacing: .06em; text-transform: uppercase; }
	details { display: grid; gap: 10px; }
	summary { cursor: pointer; font-size: .9rem; color: var(--muted); text-align: center; }
	.note { font-size: .84rem; line-height: 1.55; color: var(--muted); text-align: center; }
	.note a, .jump a { color: var(--teal-text); text-decoration: underline; }
	.works { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; margin-top: 4px; font-size: .86rem; }
	.works span { font: .7rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
	.works a { border: 1px solid var(--line); border-radius: 999px; padding: .25em .8em; color: var(--fg); }
	.jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; margin-top: 8px; font-size: .92rem; }
</style>
