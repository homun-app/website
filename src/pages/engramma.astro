---
import Page from "../layouts/Page.astro";
import ProductSymbol from "../components/brand/ProductSymbol.astro";
import Terminal from "../components/family/Terminal.astro";
import Pipeline from "../components/family/Pipeline.astro";
import DeepDive from "../components/family/DeepDive.astro";
import NumbersBand from "../components/family/NumbersBand.astro";
import ReleasesRoadmap from "../components/family/ReleasesRoadmap.astro";
import Faq from "../components/family/Faq.astro";
import NoteCard from "../components/engramma/NoteCard.astro";
import InstallCommand from "../components/engramma/InstallCommand.astro";
import Hub from "../components/engramma/Hub.astro";
import MeaningVisual from "../components/engramma/MeaningVisual.astro";
import GraphVisual from "../components/engramma/GraphVisual.astro";
import TimeVisual from "../components/engramma/TimeVisual.astro";
import QueueVisual from "../components/engramma/QueueVisual.astro";
import Rules from "../components/engramma/Rules.astro";
import CompareTable from "../components/engramma/CompareTable.astro";
import ConnectClients from "../components/engramma/ConnectClients.astro";
import {
	ENGRAMMA_RELEASE, ENGRAMMA_SHORT_INSTALL, ENGRAMMA_HERO_TERMINAL, ENGRAMMA_HERO_NOTE,
	ENGRAMMA_PIPELINE, ENGRAMMA_NUMBERS, ENGRAMMA_ROADMAP, ENGRAMMA_FAQ,
	ENGRAMMA_WORKS_WITH, ENGRAMMA_PLATFORMS_LINE,
} from "../data/engramma.mjs";

// "0.6.19-beta.1" reads "beta 0.6.19" on the page.
const beta = ENGRAMMA_RELEASE.version.split("-")[0];
---

<Page title="Engramma · Memory for assistants" description="One memory for all your AI tools: what Claude Code learned, Codex knows. Notes you can read, linked in a graph, searched by words and meaning, every fact with who said it and why it matched. Developer preview.">
	<header id="install" class="hero" data-product="engramma">
		<div>
			<div class="id">
				<ProductSymbol product="engramma" size={44} />
				<span class="name">Engramma</span>
				<span class="tag">beta {beta}</span>
			</div>
			<h1>Memory your assistant can <em>prove</em>.</h1>
			<p class="lead">One memory for all your AI tools: what Claude Code learned, Codex knows. Notes you can read, linked in a graph, searched by words and meaning with a model that runs inside the engine — every fact with who said it, its source, its dates and why it matched.</p>
			<div class="install">
				<InstallCommand command={ENGRAMMA_SHORT_INSTALL} />
				<p class="small">{ENGRAMMA_PLATFORMS_LINE} · <a href={ENGRAMMA_RELEASE.releaseUrl}>release notes</a> · <a href={ENGRAMMA_RELEASE.installerUrl}>installer of this version</a> · <a href={ENGRAMMA_RELEASE.repository}>GitHub</a></p>
			</div>
			<div class="works">
				<span>Works with</span>
				{ENGRAMMA_WORKS_WITH.map((name) => <a class="chip" href="#connect">{name}</a>)}
			</div>
		</div>
		<div class="shot">
			<Terminal product="engramma" lines={ENGRAMMA_HERO_TERMINAL.lines} motion="now" label="A search that explains its result, then the check of the log" />
			<NoteCard note={ENGRAMMA_HERO_NOTE} motion="now" />
		</div>
	</header>

	<section id="shared" class="f-band section" data-product="engramma" aria-labelledby="shared-title">
		<div class="f-wrap">
			<div class="f-head">
				<p class="f-eyebrow">One memory, every tool</p>
				<h2 id="shared-title">What one assistant learns, the others know.</h2>
				<p class="f-lead">Claude Code, Codex, Cursor, OpenCode, ChatGPT and Homun connect to the same memory. Each signs what it proposes, your policy decides what becomes true, and the next tool picks up where the last one stopped.</p>
			</div>
			<Hub />
			<p class="capture f-small">Replayed from a real session on 0.6.19-beta.1. Story 1 ran with real clients — Claude Code proposed and MCP Inspector read — while in stories 2 and 3 the engine side is real and the clients were a driver carrying their configuration. <a href="https://github.com/homun-app/website">The capture is in the website’s repository</a>, in <code>scripts/fixtures/engramma-session.txt</code>.</p>
		</div>
	</section>

	<section id="how" class="section" data-product="engramma" aria-labelledby="how-title">
		<div class="f-wrap">
			<div class="f-head">
				<p class="f-eyebrow">Inside Engramma</p>
				<h2 id="how-title">Not a database. A memory with a method.</h2>
				<p class="f-lead">One file per memory space on your disk, and inside it five stages that turn what an assistant learns into answers you can check.</p>
			</div>
			<Pipeline product="engramma" stages={ENGRAMMA_PIPELINE} label="The five stages of a memory" />
		</div>
	</section>

	<DeepDive id="meaning" product="engramma" tone="band" eyebrow="Meaning · embedded model" title="A language model inside the engine."
		lead="Engramma turns every note into a vector with IBM Granite Embedding Multilingual R2, running in-process in pure Rust. No API key, no service to call, nothing leaves your computer. It finds a note asked in other words, or in another language."
		chips={["Granite R2 · 97M", "Apache 2.0", "tract · pure Rust", "384 dims · int8", "model downloaded once"]}>
		<MeaningVisual slot="visual" />
	</DeepDive>

	<DeepDive id="graph" product="engramma" flip eyebrow="Graph" title="Names connect what you told it."
		lead="Every [[name]] in a note becomes an entity. When a question mentions one, a personalized PageRank walks the graph from it and brings up notes that never mention the words you used."
		chips={["entities + aliases", "personalized PageRank", "walks from the names a question mentions"]}>
		<GraphVisual slot="visual" />
	</DeepDive>

	<DeepDive id="time" product="engramma" tight eyebrow="Time" title="Facts change. History stays."
		lead="Notes carry when they are valid. A new fact supersedes the old one instead of overwriting it, so you can ask what was true on any date."
		chips={["valid_from / valid_to", "supersede, never overwrite", "--as-of"]}>
		<TimeVisual slot="visual" />
	</DeepDive>

	<DeepDive id="trust" product="engramma" tone="band" flip eyebrow="Control" title="Nothing enters unchecked."
		lead="What an assistant reads on the web is born in quarantine. What it wants to remember is a proposal. You accept, reject or roll back, and engramma verify replays the whole log to prove nothing else changed."
		chips={["quarantine by default", "proposals + rollback", "purge: forget for real", "verify"]}>
		<QueueVisual slot="visual" />
	</DeepDive>

	<section id="truth" class="section" data-product="engramma" aria-labelledby="truth-title">
		<div class="f-wrap">
			<div class="f-head">
				<p class="f-eyebrow">How truth is kept</p>
				<h2 id="truth-title">Many tools write. One history decides.</h2>
				<p class="f-lead">When several assistants share a memory, the hard part is not storing facts: it is knowing which ones to believe. Engramma answers with rules, not with whoever wrote last.</p>
			</div>
			<Rules />
		</div>
	</section>

	<section class="f-band section nums" data-product="engramma" aria-labelledby="nums-title">
		<div class="f-wrap">
			<h2 id="nums-title" class="sr-only">The numbers, and where each one comes from</h2>
			<NumbersBand product="engramma" numbers={ENGRAMMA_NUMBERS} />
		</div>
	</section>

	<section id="different" class="section" data-product="engramma" aria-labelledby="different-title">
		<div class="f-wrap">
			<div class="f-head">
				<p class="f-eyebrow">Why Engramma</p>
				<h2 id="different-title">Memory you can check.</h2>
				<p class="f-lead">Most memory layers are a store the assistant writes into and you have to trust. Engramma is built the other way round.</p>
			</div>
			<CompareTable />
		</div>
	</section>

	<ConnectClients />

	<section id="roadmap" class="f-band section" data-product="engramma" aria-labelledby="roadmap-title">
		<div class="f-wrap">
			<div class="f-head">
				<p class="f-eyebrow">Releases and roadmap</p>
				<h2 id="roadmap-title">From your memory, to your team’s, to your company’s.</h2>
				<p class="f-lead">Every release below is tagged in the repository. What comes next follows the <a href={ENGRAMMA_RELEASE.designUrl}>design document</a>.</p>
			</div>
			<ReleasesRoadmap product="engramma" shipped={ENGRAMMA_ROADMAP.shipped} now={ENGRAMMA_ROADMAP.now} next={ENGRAMMA_ROADMAP.next} vision={ENGRAMMA_ROADMAP.vision} />
		</div>
	</section>

	<section id="faq" class="section" data-product="engramma" aria-labelledby="faq-title">
		<div class="f-wrap">
			<div class="f-head">
				<p class="f-eyebrow">Questions</p>
				<h2 id="faq-title">Asked before you install.</h2>
			</div>
			<Faq product="engramma" items={ENGRAMMA_FAQ} />
		</div>
	</section>

	<section id="start" class="close f-wrap" data-product="engramma" aria-labelledby="start-title">
		<h2 id="start-title">Start a memory in a minute.</h2>
		<InstallCommand command={ENGRAMMA_SHORT_INSTALL} class="wide" />
		<p class="small">A beta: the command line can still change, and memory written by this version opens in every later one (<a href={ENGRAMMA_RELEASE.compatibilityUrl}>the compatibility promise</a>).</p>
		<p class="small">The macOS binary is not signed yet. The terminal installer above is not blocked by Gatekeeper; a file downloaded from the browser is.</p>
		<p class="small">Open source · Apache 2.0 · <a href={ENGRAMMA_RELEASE.repository}>GitHub</a> · <a href="/docs/engramma/">Docs</a> · <a href="/">Homun, with Engramma inside</a></p>
	</section>
</Page>

<style>
	/* The fixed navigation sits above the page: every anchor stops below it. */
	:global(main [id]) { scroll-margin-top: 70px; }

	.section { padding-block: clamp(80px, 12vh, 140px); }

	.sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

	/* Hero */
	.hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; gap: clamp(28px, 5vw, 64px); max-width: 1180px; margin-inline: auto; padding: calc(55px + clamp(24px, 5vh, 60px)) 16px clamp(64px, 10vh, 120px); }
	.id { display: flex; align-items: center; gap: 12px; font: 800 1.5rem var(--display); letter-spacing: -.03em; }
	.tag { padding: .15em .5em; border-radius: 6px; background: var(--accent-soft); font: .66rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); }
	h1 { margin-top: 22px; font-size: clamp(2.6rem, 6.4vw, 5rem); }
	h1 em { font-style: normal; color: var(--accent-text); }
	.lead { margin-top: 20px; font-size: clamp(1.05rem, 1.8vw, 1.22rem); line-height: 1.55; color: var(--muted); max-width: 44ch; }
	.install { display: grid; gap: 10px; max-width: 520px; margin-top: 28px; }
	.small { margin: 0; font-size: .84rem; line-height: 1.55; color: var(--muted); }
	.small a { color: var(--accent-text); }
	.works { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 22px; font-size: .85rem; }
	.works span { margin-right: 4px; font: .68rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
	.chip { padding: .22em .8em; border: 1px solid var(--line); border-radius: 999px; white-space: nowrap; }
	.chip:hover { border-color: var(--fg); }
	.shot { position: relative; display: grid; gap: 14px; min-width: 0; }
	/* The note comes forward, under the terminal that found it. */
	.shot :global(.note) { position: relative; z-index: 1; margin-top: -18px; margin-left: clamp(0px, 8%, 64px); }

	/* The sections of this page only: the dives are components of their own. */
	.section.f-band .f-lead a { color: inherit; }

	/* Closing */
	.close { display: grid; justify-items: center; gap: 18px; padding-block: clamp(80px, 12vh, 140px); text-align: center; }
	.close h2 { font-size: clamp(2rem, 5vw, 3.6rem); }
	.close :global(.cmd) { width: min(560px, 100%); }

	@media (max-width: 980px) {
		.hero { grid-template-columns: minmax(0, 1fr); align-items: start; }
	}
	@media (max-width: 640px) {
		.shot :global(.note) { margin: 0; }
	}
</style>
