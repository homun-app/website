---
import Base from "../../layouts/Base.astro";
import AppWindow from "../../components/ui/AppWindow.astro";
import ApprovalCard from "../../components/ui/ApprovalCard.astro";
import ChatMessage from "../../components/ui/ChatMessage.astro";
import SceneSection from "../../components/ui/SceneSection.astro";
---

<Base
	title="UI primitives — Homun"
	description="Internal preview of the scene UI primitives for the bot-team homepage."
	noindex
>
	<main>
		<header class="section-shell pb-6 pt-16">
			<p class="eyebrow">Internal preview</p>
			<h1 class="mt-3 text-3xl sm:text-4xl">Scene UI primitives</h1>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
				The homepage scenes are assembled from these pieces. This specimen sheet shows every primitive in every variant; it is not indexed and stays out of the sitemap.
			</p>
		</header>

		<SceneSection
			id="window"
			eyebrow="AppWindow · chat + computer"
			title="The bot works in a window of its own"
			body="Chat on the left, the bot's Computer panel on the right. Below 768 px the Computer panel stacks under the chat. An approval card interrupts the flow when a write needs you."
		>
			<AppWindow title="homun · inbox" botName="Inbox Manager" botEmoji="📥" computer>
				<ChatMessage from="system">⏱ routine «morning inbox sweep»</ChatMessage>
				<ChatMessage from="user">triage the inbox, draft the easy replies</ChatMessage>
				<ChatMessage from="bot">14 new emails read — 3 need you, the rest are newsletters</ChatMessage>
				<ApprovalCard tool="gmail.send" detail="send reply to dana: «re: kickoff moved to thursday»" state="pending" />
				<ChatMessage from="bot" status="draft">draft for dana is ready — approve to send</ChatMessage>
				<div slot="computer" class="space-y-2 font-mono text-[11px] leading-relaxed text-muted">
					<p class="flex items-center gap-2"><span class="status-dot"></span> sandbox · docker</p>
					<p class="flex justify-between"><span>gmail.read ×14</span><span class="text-accent-bright">ok</span></p>
					<p class="flex justify-between"><span>gmail.draft ×3</span><span class="text-accent-bright">ok</span></p>
					<p class="flex justify-between"><span>gmail.send ×1</span><span class="text-faint">waiting</span></p>
				</div>
			</AppWindow>
		</SceneSection>

		<SceneSection
			id="chat"
			eyebrow="ChatMessage · user / bot / system"
			title="Chat, statuses, system rows"
			body="User messages sit on the right with a neutral fill, bot replies on the left, system rows are small and centered. A status says what happened: done, draft, held."
			align="right"
		>
			<AppWindow title="homun · briefing" botName="Daily Briefing" botEmoji="☀️">
				<ChatMessage from="user">today's briefing, keep it short</ChatMessage>
				<ChatMessage from="bot" status="done">calendar read — 3 meetings, first at 09:30</ChatMessage>
				<ChatMessage from="system">⏱ routine «daily briefing» · 07:00</ChatMessage>
				<ChatMessage from="bot" status="held">the 09:30 clashes with the design review — move it?</ChatMessage>
			</AppWindow>
		</SceneSection>

		<SceneSection
			id="approval"
			eyebrow="ApprovalCard · pending / allowed / denied"
			title="Every write asks first"
			body="Reads are free, sends stay in draft, real writes stop behind an approval card: allow once, always allow, or deny. The same card shows the outcome once decided."
			variant="highlight"
		>
			<div class="grid gap-4 sm:grid-cols-3">
				<ApprovalCard tool="slack.post" detail="post «deploy done» to #team" state="pending" />
				<ApprovalCard tool="calendar.create" detail="add «dentist» on friday at 14:00" state="allowed" />
				<ApprovalCard tool="sheets.write" detail="update the budget sheet with october costs" state="denied" />
			</div>
		</SceneSection>

		<SceneSection
			id="memory"
			eyebrow="SceneSection · highlight + align right"
			title="The highlight variant"
			body="A slightly different background marks the memory section. Text aligns right, the scene moves left."
			variant="highlight"
			align="right"
		>
			<AppWindow title="homun · memory" botName="Account Manager" botEmoji="🧠">
				<ChatMessage from="bot" status="done">learned: acme only signs annual contracts</ChatMessage>
				<ChatMessage from="system">engramma · memory updated · shared with account manager</ChatMessage>
				<ChatMessage from="user">what do you remember about acme?</ChatMessage>
				<ChatMessage from="bot">1 fact — added yesterday, editable and deletable in memory</ChatMessage>
			</AppWindow>
		</SceneSection>
	</main>

	<footer class="section-shell py-10 text-sm text-faint">
		Internal preview · not indexed · <a href="/privacy/" class="link-accent">Privacy</a>
	</footer>
</Base>
